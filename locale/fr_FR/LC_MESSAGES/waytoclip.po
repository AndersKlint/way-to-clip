#: prefs.js:70
msgid "History Size"
msgstr "Taille de l'historique"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Taille maximale du fichier cache (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Confirmer l'effacement de l'historique"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Déplacer l'élément vers le haut après la sélection"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Conserver l'entrée sélectionnée après l'effacement de l'historique"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Effacer l'historique du presse-papiers au redémarrage du système"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Coller lors de la sélection"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr "Coller automatiquement après la sélection d'un élément de la fenêtre"

#: prefs.js:109
msgid "Popup position"
msgstr "Position de la fenêtre"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Endroit où afficher la fenêtre du presse-papiers"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Limiter le nombre de pages"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr "Si désactivé, la fenêtre affiche tout l'historique du presse-papiers"

#: prefs.js:120
msgid "Number of pages"
msgstr "Nombre de pages"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Chaque page affiche 10 éléments (Tab pour changer de page)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Taille des miniatures d'images (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Taille d'aperçu des images dans la fenêtre"

#: prefs.js:140
msgid "Cache images"
msgstr "Mettre les images en cache"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Enregistrez les images sur le disque pour qu'elles survivent à un "
"redémarrage. Sinon, elles ne sont conservées qu'en mémoire"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Ignorer les types secrets du presse-papiers"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Ignorer le contenu marqué d'un type MIME secret (gestionnaires de "
"mots de passe)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Activer les favoris"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Marquez les entrées comme favorites et parcourez-les dans la fenêtre"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Applications exclues"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Le contenu copié ne sera pas enregistré tant que ces applications sont "
"actives"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Terminaux"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Le collage automatique utilise Ctrl+Maj+V dans les terminaux. Ajoutez votre "
"terminal si le collage insère un texte incorrect"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Effacer l'historique du presse-papiers à intervalles réguliers"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Intervalle d'effacement de l'historique (en minutes)"

