#: extension.js:171
msgid "Show clipboard popup"
msgstr "Zobraziť kontextové okno schránky"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "Súkromný režim"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "Vymazať históriu"

#: extension.js:242
msgid "Settings"
msgstr "Nastavenia"

#: extension.js:329
msgid "Clear all?"
msgstr "Vyčistiť všetko?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Naozaj chcete odstrániť všetky položky schránky?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Táto akcia sa nedá odvolať."

#: extension.js:332
msgid "Clear"
msgstr "Vyčistiť"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Zrušiť"

#: prefs.js:46
msgid "History Size"
msgstr "Veľkosť histórie"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Max. veľkosť súboru vyrovnávacej pamäte (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Zobraziť potvrdenie pri čistení histórie"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Po výbere presunúť položku na začiatok zoznamu"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Ponechať vybranú položku po vyčistení histórie"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Vymazať históriu schránky pri reštarte systému"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Automatické vkladanie pri výbere"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automaticky vložiť po výbere položky z kontextového okna"

#: prefs.js:85
msgid "Popup position"
msgstr "Poloha kontextového okna"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Kde zobrazovať kontextové okno schránky"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Obmedziť počet stránok"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Ak je vypnuté, kontextové okno zobrazuje celú históriu schránky"

#: prefs.js:96
msgid "Number of pages"
msgstr "Počet stránok"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Každá stránka zobrazuje 10 položiek (Tab na prepínanie stránok)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Veľkosť miniatúr obrázkov (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Veľkosť ukážky obrázkov v kontextovom okne"

#: prefs.js:116
msgid "Cache images"
msgstr "Ukladať obrázky do vyrovnávacej pamäte"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Vylúčené aplikácie"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Skopírovaný obsah sa neuloží, kým sú tieto aplikácie aktívne"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminálové aplikácie"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatické vkladanie používa v termináloch Ctrl+Shift+V. Pridajte svoj "
"terminál, ak vkladanie vkladá nesprávny text"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Mazať históriu schránky v intervaloch"

