#: prefs.js:334
msgid "Enable shortcuts"
msgstr "Povoliť klávesové skratky"

#: prefs.js:344
msgid "Show shortcut reminder icons"
msgstr "Zobrazovať ikony pripomienok skratiek"

#: prefs.js:345
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Zobrazovať ikony pripomienok skratiek v dolnej časti kontextového okna"

#: prefs.js:354
msgid "Reset shortcuts to defaults"
msgstr "Obnoviť predvolené skratky"

#: prefs.js:356
msgid "Reset"
msgstr "Obnoviť"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
