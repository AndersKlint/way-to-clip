#: prefs.js:313
msgid "Toggle private mode"
msgstr "Prepnúť súkromný režim"

#: prefs.js:314
msgid "Next page"
msgstr "Nasledujúca stránka"

#: prefs.js:315
msgid "Previous page"
msgstr "Predchádzajúca stránka"

#: prefs.js:316
msgid "Move selection up"
