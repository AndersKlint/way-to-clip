#: prefs.js:80
msgid "History Size"
msgstr "Veľkosť histórie"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Max. veľkosť súboru vyrovnávacej pamäte (MB)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Zobraziť potvrdenie pri čistení histórie"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Po výbere presunúť položku na začiatok zoznamu"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Ponechať vybranú položku po vyčistení histórie"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Vymazať históriu schránky pri reštarte systému"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Automatické vkladanie pri výbere"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automaticky vložiť po výbere položky z kontextového okna"

#: prefs.js:119
msgid "Popup position"
msgstr "Poloha kontextového okna"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Kde zobrazovať kontextové okno schránky"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Obmedziť počet stránok"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "Ak je vypnuté, kontextové okno zobrazuje celú históriu schránky"

#: prefs.js:130
msgid "Number of pages"
msgstr "Počet stránok"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Každá stránka zobrazuje 10 položiek (Tab na prepínanie stránok)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Veľkosť miniatúr obrázkov (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Veľkosť ukážky obrázkov v kontextovom okne"

#: prefs.js:150
msgid "Cache images"
msgstr "Ukladať obrázky do vyrovnávacej pamäte"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Ukladajte obrázky na disk, aby prežili reštart. Inak sa uchovávajú iba v "
"pamäti"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Ignorovať tajné typy schránky"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Preskočiť obsah označený tajným typom MIME (správcovia hesiel)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Povoliť obľúbené"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Označte položky ako obľúbené a prehľadávajte ich v kontextovom okne"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Vylúčené aplikácie"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Skopírovaný obsah sa neuloží, kým sú tieto aplikácie aktívne"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Terminálové aplikácie"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatické vkladanie používa v termináloch Ctrl+Shift+V. Pridajte svoj "
"terminál, ak vkladanie vkladá nesprávny text"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Mazať históriu schránky v intervaloch"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Interval mazania histórie (v minútach)"

#: prefs.js:215
msgid "Language"
msgstr "Jazyk"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "Vyžaduje opätovné otvorenie Nastavení a reštart rozšírenia"

#: prefs.js:220
msgid "General"
msgstr "Všeobecné"

#: prefs.js:221
msgid "Popup"
msgstr "Kontextové okno"

#: prefs.js:222
msgid "Behavior"
msgstr "Správanie"

#: prefs.js:223
msgid "Exclusion"
msgstr "Vylúčenie"

#: prefs.js:224
msgid "Limits"
msgstr "Limity"

#: prefs.js:226
msgid "Global shortcuts"
msgstr "Globálne klávesové skratky"

#: prefs.js:231
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr "Predvolene vypnuté; priraďte nižšie skratku na povolenie každej akcie"

#: prefs.js:233
msgid "Popup shortcuts"
msgstr "Skratky kontextového okna"

#: prefs.js:291
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Názov triedy okna, napr. „KeePassXC“"

#: prefs.js:300
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Trieda okna alebo ID aplikácie, napr. „org.gnome.Ptyxis“"

