#: prefs.js:401
msgid "Enable shortcuts"
msgstr "Povoliť klávesové skratky"

#: prefs.js:410
msgid "Suggested shortcuts: Alt+X, Alt+C, or Alt+V"
msgstr "Navrhované skratky: Alt+X, Alt+C alebo Alt+V"

#: prefs.js:456
