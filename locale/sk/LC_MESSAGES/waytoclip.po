msgstr "Pri kurzore myši"

#: prefs.js:347
msgid "Center of focused window"
msgstr "V strede aktívneho okna"

#: prefs.js:352
msgid "Toggle the clipboard popup"
msgstr "Zobraziť/skryť kontextové okno schránky"

