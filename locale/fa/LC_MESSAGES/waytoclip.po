"محتوای رونوشت‌شده ذخیره نخواهد شد تا زمانی که این برنامه‌ها در کانون باشند"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "برنامه‌های پایانه"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
