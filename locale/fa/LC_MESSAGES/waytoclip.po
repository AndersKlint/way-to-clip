#: prefs.js:80
msgid "History Size"
msgstr "اندازهٔ‌ تاریخچه"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "بیشینهٔ اندازهٔ پروندهٔ انبارش (م‌ب)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "نمایش تائیدیه هنگام پاک‌سازی تاریخچه"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "جابه‌جایی مورد به بالا پس از گزینش"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "نگه داشتن ورودی برگزیده پس از پاک‌سازی تاریخچه"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "پاک‌سازی تاریخچهٔ تخته‌گیره هنگام بازراه‌اندازی سامانه"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "چسباندن خودکار هنگام گزینش"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "چسباندن خودکار پس از گزینش موردی از پنجره"

#: prefs.js:119
msgid "Popup position"
msgstr "جایگاه پنجره"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "محل نمایش پنجرهٔ تخته‌گیره"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "محدود کردن شمار صفحه‌ها"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "اگر خاموش باشد، پنجره تاریخچهٔ کامل تخته‌گیره را نشان می‌دهد"

#: prefs.js:130
msgid "Number of pages"
msgstr "شمار صفحه‌ها"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "هر صفحه ۱۰ مورد را نشان می‌دهد (Tab برای جابه‌جایی میان صفحه‌ها)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "اندازهٔ بندانگشتی تصویرها (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "اندازهٔ پیش‌نمایش تصویرها در پنجره"

#: prefs.js:150
msgid "Cache images"
msgstr "نهان‌سازی تصویرها"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"تصویرها را روی دیسک ذخیره کنید تا از راه‌اندازی دوباره جان به در برند. در غیر "
"این صورت فقط در حافظه نگه داشته می‌شوند"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "نادیده گرفتن گونه‌های محرمانهٔ تخته‌گیره"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "رد شدن از محتوای دارای گونهٔ MIME محرمانه (مدیران گذرواژه)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "به کار اندازی علاقه‌مندی‌ها"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "ورودی‌ها را به‌عنوان علاقه‌مندی نشان کنید و آن‌ها را در پنجره مرور کنید"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "برنامه‌های مستثنا"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"محتوای رونوشت‌شده ذخیره نخواهد شد تا زمانی که این برنامه‌ها در کانون باشند"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "برنامه‌های پایانه"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"چسباندن خودکار در پایانه‌ها از Ctrl+Shift+V استفاده می‌کند. اگر چسباندن متن "
"نادرست درج می‌کند، پایانهٔ خود را بیفزایید"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "پاک‌سازی تاریخچهٔ تخته‌گیره در بازه‌های زمانی"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "بازهٔ پاک‌سازی تاریخچه (به دقیقه)"

#: prefs.js:215
msgid "Language"
msgstr "زبان"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "نیازمند باز کردن دوبارهٔ تنظیمات و راه‌اندازی دوبارهٔ افزونه است"

