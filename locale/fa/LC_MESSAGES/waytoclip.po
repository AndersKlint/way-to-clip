#: extension.js:171
msgid "Show clipboard popup"
msgstr "نمایش پنجرهٔ تخته‌گیره"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "حالت خصوصی"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "پاک‌سازی تاریخچه"

#: extension.js:242
msgid "Settings"
msgstr "تنظیمات"

#: extension.js:329
msgid "Clear all?"
msgstr "همه پاک شوند؟"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "آیا از حذف همهٔ موارد تخته‌گیره مطمئنید؟"

