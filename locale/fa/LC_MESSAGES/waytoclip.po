#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "چسباندن خودکار هنگام گزینش"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "چسباندن خودکار پس از گزینش موردی از پنجره"

