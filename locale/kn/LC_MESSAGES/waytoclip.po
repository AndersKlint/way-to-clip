#: extension.js:171
msgid "Show clipboard popup"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಪಾಪ್‌ಅಪ್ ತೋರಿಸಿ"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "ಖಾಸಗಿ ಮೋಡ್"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "ಇತಿಹಾಸವನ್ನು ಅಳಿಸಿ"

#: extension.js:242
msgid "Settings"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

#: extension.js:329
msgid "Clear all?"
msgstr "ಎಲ್ಲಾ ಅಳಿಸಬಹುದೇ?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "ನೀವು ಎಲ್ಲಾ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಐಟಂಗಳನ್ನು ಅಳಿಸಲು ಖಚಿತವೇ?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "ಈ ಕಾರ್ಯವನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: extension.js:332
msgid "Clear"
msgstr "ಅಳಿಸಿ"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "ರದ್ದುಗೊಳಿಸಿ"

#: prefs.js:46
msgid "History Size"
msgstr "ಇತಿಹಾಸದ ಗಾತ್ರ"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "ಗರಿಷ್ಠ ಕಾಚೆ ಫೈಲ್ ಗಾತ್ರ (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "ಇತಿಹಾಸವನ್ನು ಅಳಿಸುವಾಗ ದೃಢೀಕರಣ ತೋರಿಸಿ"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "ಆಯ್ಕೆ ಮಾಡಿದ ನಂತರ ಐಟಂವನ್ನು ಮೇಲಕ್ಕೆ ಸರಿಸಿ"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "ಇತಿಹಾಸ ಅಳಿಸಿದ ನಂತರ ಆಯ್ಕೆ ಮಾಡಿದ ಎಂಟ್ರಿಯನ್ನು ಉಳಿಸಿ"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "ಸಿಸ್ಟಮ್ ರೀಬೂಟ್ ಆದಾಗ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಇತಿಹಾಸವನ್ನು ಅಳಿಸಿ"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "ಆಯ್ಕೆಯ ಮೇಲೆ ಸ್ವಯಂ-ಅಂಟಿಸಿ"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "ಪಾಪ್‌ಅಪ್‌ನಿಂದ ಐಟಂ ಆಯ್ಕೆ ಮಾಡಿದ ನಂತರ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಂಟಿಸಿ"

#: prefs.js:85
msgid "Popup position"
msgstr "ಪಾಪ್‌ಅಪ್ ಸ್ಥಾನ"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಪಾಪ್‌ಅಪ್ ಎಲ್ಲಿ ತೋರಿಸಬೇಕು"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "ಪುಟಗಳ ಸಂಖ್ಯೆಯನ್ನು ಮಿತಿಗೊಳಿಸಿ"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "ಆಫ್ ಆಗಿದ್ದಾಗ, ಪಾಪ್‌ಅಪ್ ಪೂರ್ಣ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಇತಿಹಾಸವನ್ನು ತೋರಿಸುತ್ತದೆ"

#: prefs.js:96
msgid "Number of pages"
msgstr "ಪುಟಗಳ ಸಂಖ್ಯೆ"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "ಪ್ರತಿ ಪುಟವು 10 ಐಟಂಗಳನ್ನು ತೋರಿಸುತ್ತದೆ (ಪುಟಗಳನ್ನು ಬದಲಾಯಿಸಲು Tab)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "ಚಿತ್ರ ಥಂಬ್‌ನೇಲ್ ಗಾತ್ರ (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "ಪಾಪ್‌ಅಪ್‌ನಲ್ಲಿ ಚಿತ್ರಗಳ ಮುನ್ನೋಟ ಗಾತ್ರ"

#: prefs.js:116
msgid "Cache images"
msgstr "ಚಿತ್ರಗಳನ್ನು ಕ್ಯಾಶ್ ಮಾಡಿ"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "ಹೊರಗಿಡಲಾದ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "ಈ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ಫೋಕಸ್‌ನಲ್ಲಿರುವಾಗ ನಕಲಿಸಿದ ವಿಷಯವನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "ಟರ್ಮಿನಲ್ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"ಟರ್ಮಿನಲ್‌ಗಳಲ್ಲಿ ಸ್ವಯಂ-ಅಂಟಿಸುವಿಕೆಯು Ctrl+Shift+V ಬಳಸುತ್ತದೆ. ಅಂಟಿಸುವಿಕೆಯು ತಪ್ಪಾದ "
"ಪಠ್ಯವನ್ನು ಸೇರಿಸಿದರೆ ನಿಮ್ಮ ಟರ್ಮಿನಲ್ ಸೇರಿಸಿ"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "ನಿಗದಿತ ಅಂತರದಲ್ಲಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಇತಿಹಾಸವನ್ನು ಅಳಿಸಿ"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "ಇತಿಹಾಸ ಅಳಿಸುವ ಅಂತರ (ನಿಮಿಷಗಳಲ್ಲಿ)"

#: prefs.js:168
msgid "Language"
msgstr "ಭಾಷೆ"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮತ್ತೆ ತೆರೆದು ವಿಸ್ತರಣೆಯನ್ನು ಮರುಪ್ರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ"

