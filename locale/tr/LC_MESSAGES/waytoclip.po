#: prefs.js:70
msgid "History Size"
msgstr "Geçmiş boyutu"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "En yüksek önbellek boyutu (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Geçmişi temizlerken onay iste"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Seçilen öğeyi en üste taşı"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Seçili girdiyi geçmişi temizlerken sakla"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Pano geçmişini sistem yeniden başlatıldığında temizle"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Seçerken yapıştır"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr "Açılır pencereden bir öğe seçtikten sonra otomatik olarak yapıştır"

#: prefs.js:109
msgid "Popup position"
msgstr "Açılır pencere konumu"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Pano penceresinin gösterileceği yer"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Sayfa sayısını sınırla"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr "Kapalıyken açılır pencere tüm pano geçmişini gösterir"

#: prefs.js:120
msgid "Number of pages"
msgstr "Sayfa sayısı"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Her sayfa 10 öğe gösterir (sayfalar arası geçiş için Tab)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Küçük resim boyutu (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Açılır penceredeki resimlerin önizleme boyutu"

#: prefs.js:140
msgid "Cache images"
msgstr "Resimleri önbellekte tut"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Resimleri yeniden başlatmaya dayanması için diske kaydedin. Aksi "
"takdirde yalnızca bellekte tutulurlar"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Gizli pano türlerini yoksay"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Gizli MIME türüyle işaretli içeriği atla (parola yöneticileri)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Favorileri etkinleştir"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Girdileri favori olarak işaretleyin ve açılır pencerede göz atın"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Dışlanan Uygulamalar"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Bu uygulamalar odaklanmışsa kopyalanan içerikler kaydedilmeyecek"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Uçbirim Uygulamaları"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Otomatik yapıştırma, uçbirimlerde Ctrl+Shift+V kullanır. Yapıştırma yanlış "
"metin eklerse uçbiriminizi ekleyin"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Pano geçmişini düzenli aralıklarla temizle"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Geçmiş temizleme aralığı (dakika olarak)"

#: prefs.js:205
msgid "Language"
msgstr "Dil"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr ""
"Ayarların yeniden açılmasını ve eklentinin yeniden başlatılmasını gerektirir"

