#: extension.js:171
msgid "Show clipboard popup"
msgstr "Pano penceresini göster"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "Gizli kip"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "Geçmişi temizle"

#: extension.js:242
msgid "Settings"
msgstr "Ayarlar"

#: extension.js:329
msgid "Clear all?"
msgstr "Hepsi temizlensin mi?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Tüm pano öğelerini silmek istediğinizden emin misiniz?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Bu işlem geri alınamaz."

#: extension.js:332
msgid "Clear"
