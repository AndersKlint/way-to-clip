msgid "When off, the popup shows the full clipboard history"
msgstr "Kapalıyken açılır pencere tüm pano geçmişini gösterir"

#: prefs.js:96
msgid "Number of pages"
msgstr "Sayfa sayısı"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Her sayfa 10 öğe gösterir (sayfalar arası geçiş için Tab)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Küçük resim boyutu (px)"

