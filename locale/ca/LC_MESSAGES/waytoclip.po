msgstr "Pàgina anterior"

#: prefs.js:353
msgid "Move selection up"
msgstr "Mou la selecció cap amunt"

#: prefs.js:354
msgid "Move selection down"
msgstr "Mou la selecció cap avall"

#: prefs.js:355
msgid "Confirm selection"
msgstr "Confirma la selecció"

#: prefs.js:356
msgid "Close popup"
msgstr "Tanca la finestra emergent"

#: prefs.js:357
msgid "Match case (while searching)"
msgstr "Distingeix majúscules (en cercar)"

#: prefs.js:358
msgid "Use regular expression (while searching)"
msgstr "Utilitza una expressió regular (en cercar)"

#: prefs.js:359
msgid "Toggle favorite on selected entry"
msgstr "Commuta el preferit de l'entrada seleccionada"

#: prefs.js:360
msgid "Open favorites or go back"
msgstr "Obre els preferits o torna enrere"

#: prefs.js:361
msgid "Quick select item 1"
msgstr "Selecció ràpida de l'entrada 1"

#: prefs.js:362
msgid "Quick select item 2"
msgstr "Selecció ràpida de l'entrada 2"

#: prefs.js:363
