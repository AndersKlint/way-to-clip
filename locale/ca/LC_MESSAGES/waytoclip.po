#: prefs.js:365
msgid "Quick select item 5"
msgstr "Selecció ràpida de l'entrada 5"

#: prefs.js:366
msgid "Quick select item 6"
msgstr "Selecció ràpida de l'entrada 6"

#: prefs.js:367
msgid "Quick select item 7"
msgstr "Selecció ràpida de l'entrada 7"

#: prefs.js:368
msgid "Quick select item 8"
msgstr "Selecció ràpida de l'entrada 8"

#: prefs.js:369
msgid "Quick select item 9"
msgstr "Selecció ràpida de l'entrada 9"

#: prefs.js:370
msgid "Quick select item 10"
msgstr "Selecció ràpida de l'entrada 10"

#: prefs.js:383
msgid "Enable shortcuts"
msgstr "Activa les dreceres de teclat"

#: prefs.js:393
msgid "Show shortcut reminder icons"
msgstr "Mostra les icones de recordatori de dreceres"

#: prefs.js:394
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr ""
"Mostra les icones de recordatori de dreceres a la part inferior de la "
"finestra emergent"

#: prefs.js:403
msgid "Reset shortcuts to defaults"
msgstr "Restableix les dreceres per defecte"

#: prefs.js:405
msgid "Reset"
msgstr "Restableix"

