#: prefs.js:70
msgid "History Size"
msgstr "Mida de l’historial"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Mida màxima del fitxer de memòria cau (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Mostra una confirmació en netejar l’historial"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Mou l'element al capdamunt després de seleccionar-lo"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Conserva l'entrada seleccionada després de netejar l’historial"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Neteja l’historial del porta-retalls en reiniciar el sistema"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Enganxament automàtic en seleccionar"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Enganxa automàticament després de seleccionar un element de la finestra "
"emergent"

#: prefs.js:109
msgid "Popup position"
msgstr "Posició de la finestra emergent"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "On es mostra la finestra emergent del porta-retalls"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Limita el nombre de pàgines"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Quan està desactivat, la finestra emergent mostra tot l’historial del porta-"
"retalls"

#: prefs.js:120
msgid "Number of pages"
msgstr "Nombre de pàgines"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada pàgina mostra 10 elements (Tab per navegar entre pàgines)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Mida de les miniatures d'imatges (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Mida de la previsualització de les imatges a la finestra emergent"

#: prefs.js:140
msgid "Cache images"
msgstr "Desa les imatges a la memòria cau"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Desa les imatges al disc perquè sobrevisquin a un reinici. En cas "
"contrari, només es conserven a la memòria"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Ignora els tipus secrets del porta-retalls"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Omet el contingut marcat amb un tipus MIME secret (gestors de "
"contrasenyes)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Activa els preferits"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr ""
"Marca les entrades com a preferides i fulleja-les a la finestra "
"emergent"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Aplicacions excloses"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"El contingut copiat no es desarà mentre aquestes aplicacions tinguin el focus"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Aplicacions de terminal"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"L'enganxament automàtic utilitza Ctrl+Maj+V als terminals. Afegeix el teu "
"terminal si en enganxar s'insereix el text incorrecte"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Neteja l’historial del porta-retalls a intervals"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Interval de neteja de l’historial (en minuts)"

#: prefs.js:205
msgid "Language"
msgstr "Llengua"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr "Requereix tornar a obrir els Paràmetres i reiniciar l'extensió"

#: prefs.js:210
msgid "General"
msgstr "General"

#: prefs.js:211
msgid "Popup"
msgstr "Finestra emergent"

#: prefs.js:212
msgid "Behavior"
msgstr "Comportament"

#: prefs.js:213
msgid "Exclusion"
msgstr "Exclusió"

#: prefs.js:214
msgid "Limits"
msgstr "Límits"

#: prefs.js:216
msgid "Global shortcuts"
msgstr "Dreceres de teclat globals"

#: prefs.js:221
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""
"Desactivat per defecte; assigneu una drecera a continuació per "
"activar cada acció"

#: prefs.js:223
msgid "Popup shortcuts"
msgstr "Dreceres de teclat de la finestra emergent"

#: prefs.js:281
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nom de classe de finestra, p. ex. «KeePassXC»"

#: prefs.js:290
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Classe de finestra o id d'aplicació, p. ex. «org.gnome.Ptyxis»"

#: prefs.js:300
msgid "System"
msgstr "Sistema"

#: prefs.js:336
msgid "At mouse cursor"
msgstr "Al cursor del ratolí"

#: prefs.js:337
msgid "Center of focused window"
msgstr "Al centre de la finestra enfocada"

#: prefs.js:342
msgid "Toggle the clipboard popup"
msgstr "Mostra/amaga la finestra emergent del porta-retalls"

#: prefs.js:343 src/panel/panelButton.js:97
msgid "Private mode"
msgstr "Mode privat"

#: prefs.js:344 src/panel/panelButton.js:113
msgid "Clear history"
msgstr "Esborra l’historial"

#: prefs.js:348
msgid "Search in popup"
msgstr "Cerca a la finestra emergent"

#: prefs.js:349
msgid "Delete selected entry"
msgstr "Suprimeix l'entrada seleccionada"

#: prefs.js:350
msgid "Toggle private mode"
