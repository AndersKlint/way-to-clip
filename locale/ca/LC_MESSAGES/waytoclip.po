#: extension.js:168
msgid "Show clipboard popup"
msgstr "Mostra la finestra emergent del porta-retalls"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Mode privat"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Esborra l’historial"

#: extension.js:242
msgid "Settings"
msgstr "Paràmetres"

#: extension.js:329
msgid "Clear all?"
msgstr "Voleu esborrar-ho tot?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Esteu segur que voleu suprimir tots els elements del porta-retalls?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Aquesta operació no es pot desfer."

#: extension.js:332
msgid "Clear"
msgstr "Esborra"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Cancel·la"

#: prefs.js:46
msgid "History Size"
msgstr "Mida de l’historial"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Mida màxima del fitxer de memòria cau (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Mostra una confirmació en netejar l’historial"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Mou l'element al capdamunt després de seleccionar-lo"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Conserva l'entrada seleccionada després de netejar l’historial"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Neteja l’historial del porta-retalls en reiniciar el sistema"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Enganxament automàtic en seleccionar"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Enganxa automàticament després de seleccionar un element de la finestra "
"emergent"

#: prefs.js:85
msgid "Popup position"
msgstr "Posició de la finestra emergent"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "On es mostra la finestra emergent del porta-retalls"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Limita el nombre de pàgines"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Quan està desactivat, la finestra emergent mostra tot l’historial del "
"porta-retalls"

#: prefs.js:96
msgid "Number of pages"
msgstr "Nombre de pàgines"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada pàgina mostra 10 elements (Tab per navegar entre pàgines)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Mida de les miniatures d'imatges (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Mida de la previsualització de les imatges a la finestra emergent"

#: prefs.js:116
msgid "Cache images"
msgstr "Desa les imatges a la memòria cau"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Aplicacions excloses"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "El contingut copiat no es desarà mentre aquestes aplicacions tinguin el "
"focus"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Aplicacions de terminal"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "L'enganxament automàtic utilitza Ctrl+Maj+V als terminals. Afegeix el teu "
"terminal si en enganxar s'insereix el text incorrecte"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Neteja l’historial del porta-retalls a intervals"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Interval de neteja de l’historial (en minuts)"

#: prefs.js:168
msgid "Language"
msgstr "Llengua"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Requereix tornar a obrir els Paràmetres i reiniciar l'extensió"

#: prefs.js:173
msgid "General"
msgstr "General"

#: prefs.js:174
msgid "Popup"
msgstr "Finestra emergent"

#: prefs.js:175
msgid "Behavior"
msgstr "Comportament"

#: prefs.js:176
msgid "Exclusion"
msgstr "Exclusió"

#: prefs.js:177
msgid "Limits"
msgstr "Límits"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Dreceres de teclat globals"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Dreceres de teclat de la finestra emergent"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nom de classe de finestra, p. ex. «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Classe de finestra o id d'aplicació, p. ex. «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Sistema"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "Al cursor del ratolí"

#: prefs.js:291
msgid "Center of focused window"
msgstr "Al centre de la finestra enfocada"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Mostra/amaga la finestra emergent del porta-retalls"

#: prefs.js:306
msgid "Search in popup"
msgstr "Cerca a la finestra emergent"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Suprimeix l'entrada seleccionada"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Commuta el mode privat"

#: prefs.js:309
msgid "Next page"
msgstr "Pàgina següent"

#: prefs.js:310
msgid "Previous page"
msgstr "Pàgina anterior"

#: prefs.js:311
msgid "Move selection up"
msgstr "Mou la selecció cap amunt"

#: prefs.js:312
msgid "Move selection down"
msgstr "Mou la selecció cap avall"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Confirma la selecció"

#: prefs.js:314
msgid "Close popup"
msgstr "Tanca la finestra emergent"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Distingeix majúscules (en cercar)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Utilitza una expressió regular (en cercar)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Activa les dreceres de teclat"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Mostra les icones de recordatori de dreceres"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Mostra les icones de recordatori de dreceres a la part inferior de la "
"finestra emergent"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Restableix les dreceres per defecte"

#: prefs.js:351
msgid "Reset"
msgstr "Restableix"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Afegeix una drecera"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Suprimeix la drecera"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Desactivat"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Introdueix la drecera…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Tria d'entre les aplicacions instal·lades"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Cerca aplicacions…"

#: cursor-popup/cursorPopup.js:338
#, javascript-format
msgid "Match Case (%s)"
msgstr "Distingeix majúscules (%s)"

#: cursor-popup/cursorPopup.js:342
#, javascript-format
msgid "Use Regular Expression (%s)"
msgstr "Utilitza una expressió regular (%s)"

#: cursor-popup/cursorPopup.js:379
#, javascript-format
msgid "Toggle search (%s)"
msgstr "Mostra/amaga la cerca (%s)"

#: cursor-popup/cursorPopup.js:381
#, javascript-format
msgid "Toggle private mode (%s)"
msgstr "Commuta el mode privat (%s)"

#: cursor-popup/cursorPopup.js:383
#, javascript-format
msgid "Delete selected entry (%s)"
msgstr "Suprimeix l'entrada seleccionada (%s)"

#: cursor-popup/cursorPopup.js:573
msgid "Clipboard history is empty"
msgstr "L'historial del porta-retalls és buit"

#: cursor-popup/cursorPopup.js:574
msgid "No matching clipboard items"
msgstr "Cap element coincident al porta-retalls"

#: cursor-popup/popupUI.js:101
msgid "Search..."
msgstr "Cerca…"

#: cursor-popup/popupUI.js:341
msgid "Match Case (Alt+C)"
msgstr "Distingeix majúscules (Alt+C)"

#: cursor-popup/popupUI.js:343
msgid "Use Regular Expression (Alt+R)"
msgstr "Utilitza una expressió regular (Alt+R)"

#: cursor-popup/popupUI.js:418
msgid "Toggle search (s)"
msgstr "Mostra/amaga la cerca (s)"

#: cursor-popup/popupUI.js:420
msgid "Toggle private mode (p)"
msgstr "Commuta el mode privat (p)"

#: cursor-popup/popupUI.js:422
msgid "Delete selected entry (d)"
msgstr "Suprimeix l'entrada seleccionada (d)"
