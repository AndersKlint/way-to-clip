#: prefs.js:80
msgid "History Size"
msgstr "Talha de l'istoric"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Talha maximala del fichièr de cache (Mo)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Afichar una confirmacion en escafissent l'istoric"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Desplaçar l’element ennaut aprèp seleccion"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Gardar l'entrada seleccionada aprèp aver escafat l'istoric"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Escafar l'istoric del quichapapièrs al reaviament del sistèma"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Pegat automatic a la seleccion"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Pegar automaticament aprèp aver seleccionat un element de la fenèstra "
"surgissenta"

#: prefs.js:119
msgid "Popup position"
msgstr "Posicion de la fenèstra surgissenta"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Ont afichar la fenèstra surgissenta del quichapapièrs"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Limitar lo nombre de paginas"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Quand es desactivat, la fenèstra surgissenta aficha tot l'istoric del "
"quichapapièrs"

#: prefs.js:130
msgid "Number of pages"
msgstr "Nombre de paginas"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada pagina aficha 10 elements (Tab per navegar entre las paginas)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Talha de las miniaturas d'imatges (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Talha de la previsualizacion dels imatges dins la fenèstra surgissenta"

#: prefs.js:150
msgid "Cache images"
msgstr "Metre los imatges en cache"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Salva los imatges sul disc per que subreviscan a un reaviament. Senon son "
"gardats sonque en memòria"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Ignorar los tipes secrets del quichapapièrs"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Sautar lo contengut marcat amb un tipe MIME secret (gestionaris de senhals)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Activar los favorits"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr ""
"Marcar las entradas coma favoridas e fulhejar-las dins la fenèstra "
"surgissenta"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Aplicacions exclausas"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Lo contengut copiat serà pas salvat mentre aquestas aplicacions son al fòcus"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Aplicacions de terminal"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Lo pegat automatic utiliza Ctrl+Shift+V dins los terminals. Apondètz vòstre "
"terminal se lo pegat inserís un tèxte incorrècte"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Escafar l'istoric del quichapapièrs a interval"

