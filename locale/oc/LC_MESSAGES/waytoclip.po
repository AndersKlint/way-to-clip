#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Ont afichar la fenèstra surgissenta del quichapapièrs"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Limitar lo nombre de paginas"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Quand es desactivat, la fenèstra surgissenta aficha tot l'istoric del "
"quichapapièrs"

#: prefs.js:96
msgid "Number of pages"
msgstr "Nombre de paginas"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada pagina aficha 10 elements (Tab per navegar entre las paginas)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Talha de las miniaturas d'imatges (px)"

