#: extension.js:168
msgid "Show clipboard popup"
msgstr "Afichar la fenèstra surgissenta del quichapapièrs"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Mòde privat"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Escafar l’istoric"

#: extension.js:242
msgid "Settings"
msgstr "Preferéncias"

#: extension.js:329
msgid "Clear all?"
msgstr "Tot escafar ?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Volètz vertadièrament suprimir totes los elements del quichapapièr ?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Aquò pòt pas èsser anullat."

#: extension.js:332
msgid "Clear"
msgstr "Escafar"

