#: prefs.js:70
msgid "History Size"
msgstr "Velikost historie"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Maximální velikost souboru mezipaměti (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Zobrazit potvrzení při mazání historie"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Po výběru posunout položku na začátek seznamu"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Ponechat vybranou položku po vymazání historie"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Vymazat historii schránky při restartu systému"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Automatické vkládání při výběru"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automaticky vložit po výběru položky z vyskakovacího okna"

#: prefs.js:109
msgid "Popup position"
msgstr "Poloha vyskakovacího okna"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Kde zobrazovat vyskakovací okno schránky"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Omezit počet stránek"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr "Pokud je vypnuto, okno zobrazuje celou historii schránky"

#: prefs.js:120
msgid "Number of pages"
msgstr "Počet stránek"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Každá stránka zobrazuje 10 položek (Tab pro přepínání stránek)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Velikost miniatur obrázků (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Velikost náhledu obrázků ve vyskakovacím okně"

#: prefs.js:140
msgid "Cache images"
msgstr "Ukládat obrázky do mezipaměti"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Ukládejte obrázky na disk, aby přežily restart. Jinak zůstanou pouze "
"v paměti"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Ignorovat tajné typy schránky"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Přeskočit obsah označený tajným typem MIME (správci hesel)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Povolit oblíbené"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Označte položky jako oblíbené a procházejte je ve vyskakovacím okně"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Vyloučené aplikace"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Zkopírovaný obsah se neuloží, dokud jsou tyto aplikace aktivní"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Terminálové aplikace"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatické vkládání používá v terminálech Ctrl+Shift+V. Přidejte svůj "
"terminál, pokud vkládání vkládá nesprávný text"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Mazat historii schránky v intervalech"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Interval mazání historie (v minutách)"

#: prefs.js:205
msgid "Language"
msgstr "Jazyk"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr "Vyžaduje znovuotevření Nastavení a restart rozšíření"

#: prefs.js:210
msgid "General"
msgstr "Obecné"

#: prefs.js:211
msgid "Popup"
msgstr "Vyskakovací okno"

#: prefs.js:212
msgid "Behavior"
msgstr "Chování"

#: prefs.js:213
msgid "Exclusion"
msgstr "Vyloučení"

#: prefs.js:214
msgid "Limits"
msgstr "Limity"

#: prefs.js:216
msgid "Global shortcuts"
msgstr "Globální klávesové zkratky"

#: prefs.js:221
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""
"Ve výchozím stavu zakázáno; každou akci povolíte přiřazením zkratky "
"níže"

#: prefs.js:223
msgid "Popup shortcuts"
msgstr "Zkratky vyskakovacího okna"

#: prefs.js:281
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Název třídy okna, např. „KeePassXC“"

#: prefs.js:290
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Třída okna nebo ID aplikace, např. „org.gnome.Ptyxis“"

#: prefs.js:300
msgid "System"
msgstr "Systém"

#: prefs.js:336
msgid "At mouse cursor"
msgstr "U kurzoru myši"

#: prefs.js:337
msgid "Center of focused window"
msgstr "Uprostřed aktivního okna"

#: prefs.js:342
msgid "Toggle the clipboard popup"
msgstr "Zobrazit/skrýt vyskakovací okno schránky"

#: prefs.js:343 src/panel/panelButton.js:97
msgid "Private mode"
msgstr "Soukromý režim"

#: prefs.js:344 src/panel/panelButton.js:113
msgid "Clear history"
msgstr "Vyčistit historii"

#: prefs.js:348
msgid "Search in popup"
msgstr "Hledat ve vyskakovacím okně"

#: prefs.js:349
msgid "Delete selected entry"
msgstr "Odstranit vybranou položku"

#: prefs.js:350
msgid "Toggle private mode"
