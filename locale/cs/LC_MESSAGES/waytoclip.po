#: prefs.js:353
msgid "Move selection up"
msgstr "Přesunout výběr nahoru"

#: prefs.js:354
msgid "Move selection down"
msgstr "Přesunout výběr dolů"

#: prefs.js:355
msgid "Confirm selection"
