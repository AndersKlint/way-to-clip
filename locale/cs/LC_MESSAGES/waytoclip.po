#: extension.js:168
msgid "Show clipboard popup"
msgstr "Zobrazit vyskakovací okno schránky"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Soukromý režim"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Vyčistit historii"

#: extension.js:242
msgid "Settings"
msgstr "Nastavení"

#: extension.js:329
msgid "Clear all?"
msgstr "Vyčistit vše?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Opravdu chcete smazat všechny položky schránky?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Tato operace nejde vrátit."

#: extension.js:332
msgid "Clear"
msgstr "Vyčistit"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Zrušit"

#: prefs.js:46
msgid "History Size"
msgstr "Velikost historie"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Maximální velikost souboru mezipaměti (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Zobrazit potvrzení při mazání historie"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Po výběru posunout položku na začátek seznamu"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Ponechat vybranou položku po vymazání historie"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Vymazat historii schránky při restartu systému"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Automatické vkládání při výběru"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automaticky vložit po výběru položky z vyskakovacího okna"

#: prefs.js:85
msgid "Popup position"
msgstr "Poloha vyskakovacího okna"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Kde zobrazovat vyskakovací okno schránky"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Omezit počet stránek"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Pokud je vypnuto, okno zobrazuje celou historii schránky"

#: prefs.js:96
msgid "Number of pages"
msgstr "Počet stránek"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Každá stránka zobrazuje 10 položek (Tab pro přepínání stránek)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Velikost miniatur obrázků (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Velikost náhledu obrázků ve vyskakovacím okně"

#: prefs.js:116
msgid "Cache images"
msgstr "Ukládat obrázky do mezipaměti"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Vyloučené aplikace"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Zkopírovaný obsah se neuloží, dokud jsou tyto aplikace aktivní"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminálové aplikace"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "Automatické vkládání používá v terminálech Ctrl+Shift+V. Přidejte svůj "
"terminál, pokud vkládání vkládá nesprávný text"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Mazat historii schránky v intervalech"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Interval mazání historie (v minutách)"

#: prefs.js:168
msgid "Language"
msgstr "Jazyk"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Vyžaduje znovuotevření Nastavení a restart rozšíření"

#: prefs.js:173
msgid "General"
msgstr "Obecné"

#: prefs.js:174
msgid "Popup"
msgstr "Vyskakovací okno"

#: prefs.js:175
msgid "Behavior"
msgstr "Chování"

#: prefs.js:176
msgid "Exclusion"
msgstr "Vyloučení"

#: prefs.js:177
msgid "Limits"
msgstr "Limity"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Globální klávesové zkratky"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Zkratky vyskakovacího okna"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Název třídy okna, např. „KeePassXC“"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Třída okna nebo ID aplikace, např. „org.gnome.Ptyxis“"

#: prefs.js:254
msgid "System"
msgstr "Systém"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "U kurzoru myši"

#: prefs.js:291
msgid "Center of focused window"
msgstr "Uprostřed aktivního okna"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Zobrazit/skrýt vyskakovací okno schránky"

#: prefs.js:306
msgid "Search in popup"
msgstr "Hledat ve vyskakovacím okně"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Odstranit vybranou položku"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Přepnout soukromý režim"

#: prefs.js:309
msgid "Next page"
msgstr "Následující stránka"

#: prefs.js:310
msgid "Previous page"
msgstr "Předchozí stránka"

#: prefs.js:311
msgid "Move selection up"
msgstr "Přesunout výběr nahoru"

#: prefs.js:312
msgid "Move selection down"
msgstr "Přesunout výběr dolů"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Potvrdit výběr"

#: prefs.js:314
msgid "Close popup"
msgstr "Zavřít vyskakovací okno"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Rozlišovat velikost písmen (při hledání)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Použít regulární výraz (při hledání)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Povolit klávesové zkratky"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Zobrazovat ikony připomínek zkratek"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Zobrazovat ikony připomínek zkratek ve spodní části vyskakovacího okna"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Obnovit výchozí zkratky"

#: prefs.js:351
msgid "Reset"
msgstr "Obnovit"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Přidat zkratku"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Odebrat zkratku"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Vypnuto"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Zadejte zkratku…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Vybrat z nainstalovaných aplikací"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Hledat aplikace…"

