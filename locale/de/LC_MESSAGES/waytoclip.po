#: prefs.js:80
msgid "History Size"
msgstr "Größe des Verlaufs"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Maximale Größe der Cachedatei (MB)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Bestätigung beim Löschen des Verlaufs anzeigen"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Eintrag nach Auswahl nach oben verschieben"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Gewählten Eintrag beim Löschen des Verlaufs beibehalten"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Verlauf beim Neustart des Systems löschen"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Automatisches Einfügen bei Auswahl"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "Nach Auswahl eines Eintrags aus dem Popup automatisch einfügen"

#: prefs.js:119
msgid "Popup position"
msgstr "Popup-Position"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Wo das Zwischenablage-Popup angezeigt wird"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Seitenanzahl begrenzen"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "Wenn deaktiviert, zeigt das Popup den gesamten Zwischenablage-Verlauf"

#: prefs.js:130
msgid "Number of pages"
msgstr "Seitenanzahl"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Jede Seite zeigt 10 Einträge (Tab zum Wechseln der Seiten)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Vorschaubildgröße für Bilder (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Vorschaugröße für Bilder im Popup"

#: prefs.js:150
msgid "Cache images"
msgstr "Bilder zwischenspeichern"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Bilder auf die Festplatte speichern, damit sie einen Neustart überstehen. "
"Andernfalls bleiben sie nur im Speicher"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Geheime Zwischenablage-Typen ignorieren"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Inhalte mit geheimem MIME-Typ überspringen (Passwort-Manager)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Favoriten aktivieren"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Einträge als Favoriten markieren und im Popup durchsuchen"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Ausgeschlossene Apps"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Kopierte Inhalte werden nicht gespeichert, solange diese Apps im Fokus sind"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Terminal-Apps"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatisches Einfügen verwendet Strg+Umschalt+V in Terminals. Fügen Sie Ihr "
"Terminal hinzu, falls beim Einfügen falscher Text eingefügt wird"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Zwischenablage-Verlauf in Intervallen löschen"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Intervall zum Löschen des Verlaufs (in Minuten)"

#: prefs.js:215
msgid "Language"
msgstr "Sprache"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr ""
"Erfordert erneutes Öffnen der Einstellungen und Neustart der Erweiterung"

