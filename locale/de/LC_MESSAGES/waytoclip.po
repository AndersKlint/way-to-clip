msgid "Content copied will not be saved while these apps are in focus"
msgstr "Kopierte Inhalte werden nicht gespeichert, solange diese Apps im Fokus sind"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminal-Apps"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "Automatisches Einfügen verwendet Strg+Umschalt+V in Terminals. Fügen Sie Ihr "
"Terminal hinzu, falls beim Einfügen falscher Text eingefügt wird"

