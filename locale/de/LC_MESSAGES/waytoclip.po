#: extension.js:168
msgid "Show clipboard popup"
msgstr "Zwischenablage-Popup anzeigen"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Privater Modus"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Verlauf löschen"

#: extension.js:242
msgid "Settings"
msgstr "Einstellungen"

#: extension.js:329
msgid "Clear all?"
msgstr "Alles löschen?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Soll die Zwischenablage wirklich geleert werden?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Diese Aktion kann nicht rückgängig gemacht werden."

#: extension.js:332
msgid "Clear"
msgstr "Löschen"

