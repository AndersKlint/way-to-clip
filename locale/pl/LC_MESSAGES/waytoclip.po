#: extension.js:171
msgid "Show clipboard popup"
msgstr "Pokaż okienko schowka"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "Tryb prywatny"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "Wyczyść historię"

#: extension.js:242
msgid "Settings"
msgstr "Ustawienia"

#: extension.js:329
msgid "Clear all?"
msgstr "Wyczyścić wszystko?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Czy jesteś pewien, że chcesz usunąć wszystkie elementy ze schowka?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Tej operacji nie będzie można cofnąć."

#: extension.js:332
msgid "Clear"
msgstr "Wyczyść"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Anuluj"

#: prefs.js:46
msgid "History Size"
msgstr "Rozmiar historii"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Maksymalny rozmiar buforu (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Pokaż potwierdzenie przed wyczyszczeniem historii"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Przenieś na początek po wybraniu"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Zachowaj wybraną pozycję po wyczyszczeniu historii"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Wyczyść historię przy uruchamianiu systemu"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Wklejaj automatycznie po wybraniu"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automatycznie wklejaj po wybraniu elementu z okienka"

#: prefs.js:85
msgid "Popup position"
msgstr "Pozycja okienka"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Miejsce wyświetlania okienka schowka"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Ogranicz liczbę stron"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Gdy wyłączone, okienko pokazuje całą historię schowka"

#: prefs.js:96
msgid "Number of pages"
msgstr "Liczba stron"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Każda strona pokazuje 10 elementów (Tab przełącza strony)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Rozmiar miniatur obrazów (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Rozmiar podglądu obrazów w okienku"

#: prefs.js:116
msgid "Cache images"
msgstr "Buforuj obrazy"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Wykluczone aplikacje"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Kopiowana treść nie zostanie zapisana, gdy te aplikacje są na pierwszym "
"planie"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminale"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatyczne wklejanie używa Ctrl+Shift+V w terminalach. Dodaj swój "
"terminal, jeśli wklejanie wstawia nieprawidłowy tekst"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Okresowo czyść historię schowka"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Częstotliwość czyszczenia historii (w minutach)"

#: prefs.js:168
msgid "Language"
msgstr "Język"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr ""
"Wymaga ponownego otwarcia Ustawień i ponownego uruchomienia rozszerzenia"

#: prefs.js:173
msgid "General"
msgstr "Ogólne"

#: prefs.js:174
msgid "Popup"
msgstr "Okienko"

#: prefs.js:175
msgid "Behavior"
msgstr "Zachowanie"

#: prefs.js:176
msgid "Exclusion"
msgstr "Wykluczanie"

#: prefs.js:177
msgid "Limits"
msgstr "Limity"

#: prefs.js:179
msgid "Global shortcuts"
msgstr "Globalne skróty klawiszowe"

#: prefs.js:182
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""

#: prefs.js:184
msgid "Popup shortcuts"
msgstr "Skróty klawiszowe okienka"

#: prefs.js:240
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nazwa klasy okna, np. \"KeePassXC\""

#: prefs.js:249
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Klasa okna lub identyfikator aplikacji, np. \"org.gnome.Ptyxis\""

#: prefs.js:259
msgid "System"
msgstr "System"

#: prefs.js:295
msgid "At mouse cursor"
msgstr "Przy kursorze myszy"

#: prefs.js:296
msgid "Center of focused window"
msgstr "Na środku aktywnego okna"

#: prefs.js:302
msgid "Toggle the clipboard popup"
msgstr "Przełącz okienko schowka"

#: prefs.js:311
msgid "Search in popup"
msgstr "Szukaj w okienku"

#: prefs.js:312
msgid "Delete selected entry"
msgstr "Usuń wybrany element"

#: prefs.js:313
msgid "Toggle private mode"
msgstr "Przełącz tryb prywatny"

#: prefs.js:314
msgid "Next page"
msgstr "Następna strona"

#: prefs.js:315
msgid "Previous page"
msgstr "Poprzednia strona"

#: prefs.js:316
msgid "Move selection up"
msgstr "Przenieś zaznaczenie w górę"

#: prefs.js:317
msgid "Move selection down"
msgstr "Przenieś zaznaczenie w dół"

#: prefs.js:318
msgid "Confirm selection"
msgstr "Potwierdź zaznaczenie"

#: prefs.js:319
msgid "Close popup"
msgstr "Zamknij okienko"

#: prefs.js:320
msgid "Match case (while searching)"
msgstr "Uwzględnij wielkość liter (podczas wyszukiwania)"

#: prefs.js:321
msgid "Use regular expression (while searching)"
msgstr "Użyj wyrażenia regularnego (podczas wyszukiwania)"

#: prefs.js:334
msgid "Enable shortcuts"
msgstr "Włącz skróty klawiszowe"

#: prefs.js:344
msgid "Show shortcut reminder icons"
msgstr "Pokazuj ikony przypominające skróty"

#: prefs.js:345
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Pokazuj ikony przypominające skróty na dole okienka"

#: prefs.js:354
msgid "Reset shortcuts to defaults"
msgstr "Przywróć domyślne skróty"

#: prefs.js:356
msgid "Reset"
msgstr "Przywróć"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Dodaj skrót"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Usuń skrót"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:364
msgid "Disabled"
msgstr "Wyłączony"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Wprowadź skrót klawiszowy…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Wybierz spośród zainstalowanych aplikacji"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Szukaj aplikacji…"

