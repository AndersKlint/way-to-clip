#: prefs.js:70
msgid "History Size"
msgstr "Rozmiar historii"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Maksymalny rozmiar buforu (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Pokaż potwierdzenie przed wyczyszczeniem historii"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Przenieś na początek po wybraniu"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Zachowaj wybraną pozycję po wyczyszczeniu historii"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Wyczyść historię przy uruchamianiu systemu"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Wklejaj automatycznie po wybraniu"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automatycznie wklejaj po wybraniu elementu z okienka"

#: prefs.js:109
msgid "Popup position"
msgstr "Pozycja okienka"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Miejsce wyświetlania okienka schowka"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Ogranicz liczbę stron"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr "Gdy wyłączone, okienko pokazuje całą historię schowka"

#: prefs.js:120
msgid "Number of pages"
msgstr "Liczba stron"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Każda strona pokazuje 10 elementów (Tab przełącza strony)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Rozmiar miniatur obrazów (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Rozmiar podglądu obrazów w okienku"

#: prefs.js:140
msgid "Cache images"
msgstr "Buforuj obrazy"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Zapisuj obrazy na dysk, aby przetrwały restart. W przeciwnym razie "
"będą przechowywane tylko w pamięci"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Ignoruj tajne typy schowka"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Pomiń treści oznaczone tajnym typem MIME (menedżery haseł)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Włącz ulubione"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Oznaczaj elementy jako ulubione i przeglądaj je w okienku"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Wykluczone aplikacje"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Kopiowana treść nie zostanie zapisana, gdy te aplikacje są na pierwszym "
"planie"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Terminale"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automatyczne wklejanie używa Ctrl+Shift+V w terminalach. Dodaj swój "
"terminal, jeśli wklejanie wstawia nieprawidłowy tekst"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Okresowo czyść historię schowka"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Częstotliwość czyszczenia historii (w minutach)"

#: prefs.js:205
msgid "Language"
msgstr "Język"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr ""
"Wymaga ponownego otwarcia Ustawień i ponownego uruchomienia rozszerzenia"

