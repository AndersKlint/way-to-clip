msgid "Toggle search (s)"
msgstr "Εμφάνιση/Απόκρυψη αναζήτησης (s)"

#: cursor-popup/popupUI.js:420
msgid "Toggle private mode (p)"
msgstr "Εναλλαγή ιδιωτικής λειτουργίας (p)"

