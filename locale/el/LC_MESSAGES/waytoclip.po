#: prefs.js:70
msgid "History Size"
msgstr "Μέγεθος ιστορικού"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Μέγιστο μέγεθος αρχείου κρυφής μνήμης (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Εμφάνιση επιβεβαίωσης κατά την εκκαθάριση ιστορικού"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Μετακίνηση στοιχείου στην κορυφή μετά την επιλογή"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Διατήρηση επιλεγμένης καταχώρησης μετά την εκκαθάριση ιστορικού"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Εκκαθάριση ιστορικού προχείρου κατά την επανεκκίνηση του συστήματος"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Αυτόματη επικόλληση κατά την επιλογή"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Αυτόματη επικόλληση μετά την επιλογή στοιχείου από το αναδυόμενο παράθυρο"

#: prefs.js:109
msgid "Popup position"
msgstr "Θέση αναδυόμενου παραθύρου"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Πού θα εμφανίζεται το αναδυόμενο παράθυρο του προχείρου"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Περιορισμός αριθμού σελίδων"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Όταν είναι απενεργοποιημένο, το αναδυόμενο παράθυρο εμφανίζει όλο το "
"ιστορικό του προχείρου"

#: prefs.js:120
msgid "Number of pages"
msgstr "Αριθμός σελίδων"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Κάθε σελίδα εμφανίζει 10 στοιχεία (Tab για πλοήγηση στις σελίδες)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Μέγεθος μικρογραφιών εικόνων (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Μέγεθος προεπισκόπησης εικόνων στο αναδυόμενο παράθυρο"

#: prefs.js:140
msgid "Cache images"
msgstr "Αποθήκευση εικόνων στην κρυφή μνήμη"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Αποθηκεύστε τις εικόνες στο δίσκο για να επιβιώσουν από "
"επανεκκίνηση. Διαφορετικά διατηρούνται μόνο στη μνήμη"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Παράβλεψη απόρρητων τύπων προχείρου"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Παράλειψη περιεχομένου με απόρρητο τύπο MIME (διαχειριστές κωδικών)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Ενεργοποίηση αγαπημένων"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr ""
"Σημειώστε τις καταχωρήσεις ως αγαπημένες και περιηγηθείτε σε αυτές "
"στο αναδυόμενο παράθυρο"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Εξαιρούμενες εφαρμογές"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Το αντιγραμμένο περιεχόμενο δεν θα αποθηκεύεται όσο αυτές οι εφαρμογές είναι "
"εστιασμένες"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Εφαρμογές τερματικού"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Η αυτόματη επικόλληση χρησιμοποιεί Ctrl+Shift+V σε τερματικά. Προσθέστε το "
"τερματικό σας αν η επικόλληση εισάγει λάθος κείμενο"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Εκκαθάριση ιστορικού προχείρου ανά διαστήματα"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Διάστημα εκκαθάρισης ιστορικού (σε λεπτά)"

#: prefs.js:205
msgid "Language"
msgstr "Γλώσσα"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr ""
"Απαιτείται εκ νέου άνοιγμα των Ρυθμίσεων και επανεκκίνηση της επέκτασης"

#: prefs.js:210
msgid "General"
msgstr "Γενικά"

#: prefs.js:211
msgid "Popup"
msgstr "Αναδυόμενο παράθυρο"

#: prefs.js:212
msgid "Behavior"
msgstr "Συμπεριφορά"

#: prefs.js:213
msgid "Exclusion"
msgstr "Εξαίρεση"

#: prefs.js:214
