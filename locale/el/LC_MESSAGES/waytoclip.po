#: extension.js:168
msgid "Show clipboard popup"
msgstr "Εμφάνιση αναδυόμενου παραθύρου προχείρου"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Ιδιωτική λειτουργία"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Εκκάθαρση ιστορικού"

#: extension.js:242
msgid "Settings"
msgstr "Ρυθμίσεις"

#: extension.js:329
msgid "Clear all?"
msgstr "Εκκαθάριση όλων;"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Είστε βέβαιοι ότι θέλετε να διαγράψετε όλα τα στοιχεία του προχείρου;"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."

#: extension.js:332
msgid "Clear"
msgstr "Εκκαθάριση"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Ακύρωση"

#: prefs.js:46
msgid "History Size"
msgstr "Μέγεθος ιστορικού"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Μέγιστο μέγεθος αρχείου κρυφής μνήμης (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Εμφάνιση επιβεβαίωσης κατά την εκκαθάριση ιστορικού"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Μετακίνηση στοιχείου στην κορυφή μετά την επιλογή"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Διατήρηση επιλεγμένης καταχώρησης μετά την εκκαθάριση ιστορικού"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Εκκαθάριση ιστορικού προχείρου κατά την επανεκκίνηση του συστήματος"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Αυτόματη επικόλληση κατά την επιλογή"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Αυτόματη επικόλληση μετά την επιλογή στοιχείου από το αναδυόμενο παράθυρο"

#: prefs.js:85
msgid "Popup position"
msgstr "Θέση αναδυόμενου παραθύρου"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Πού θα εμφανίζεται το αναδυόμενο παράθυρο του προχείρου"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Περιορισμός αριθμού σελίδων"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Όταν είναι απενεργοποιημένο, το αναδυόμενο παράθυρο εμφανίζει όλο το "
"ιστορικό του προχείρου"

#: prefs.js:96
msgid "Number of pages"
msgstr "Αριθμός σελίδων"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Κάθε σελίδα εμφανίζει 10 στοιχεία (Tab για πλοήγηση στις σελίδες)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Μέγεθος μικρογραφιών εικόνων (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Μέγεθος προεπισκόπησης εικόνων στο αναδυόμενο παράθυρο"

#: prefs.js:116
msgid "Cache images"
msgstr "Αποθήκευση εικόνων στην κρυφή μνήμη"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Εξαιρούμενες εφαρμογές"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Το αντιγραμμένο περιεχόμενο δεν θα αποθηκεύεται όσο αυτές οι εφαρμογές είναι "
"εστιασμένες"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Εφαρμογές τερματικού"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "Η αυτόματη επικόλληση χρησιμοποιεί Ctrl+Shift+V σε τερματικά. Προσθέστε το "
"τερματικό σας αν η επικόλληση εισάγει λάθος κείμενο"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Εκκαθάριση ιστορικού προχείρου ανά διαστήματα"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Διάστημα εκκαθάρισης ιστορικού (σε λεπτά)"

#: prefs.js:168
msgid "Language"
msgstr "Γλώσσα"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Απαιτείται εκ νέου άνοιγμα των Ρυθμίσεων και επανεκκίνηση της επέκτασης"

#: prefs.js:173
msgid "General"
msgstr "Γενικά"

#: prefs.js:174
msgid "Popup"
msgstr "Αναδυόμενο παράθυρο"

#: prefs.js:175
msgid "Behavior"
msgstr "Συμπεριφορά"

#: prefs.js:176
msgid "Exclusion"
msgstr "Εξαίρεση"

#: prefs.js:177
msgid "Limits"
msgstr "Όρια"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Καθολικές συντομεύσεις πληκτρολογίου"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Συντομεύσεις αναδυόμενου παραθύρου"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Όνομα κλάσης παραθύρου, π.χ. «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Κλάση παραθύρου ή id εφαρμογής, π.χ. «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Σύστημα"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "Στον δρομέα του ποντικιού"

#: prefs.js:291
msgid "Center of focused window"
msgstr "Στο κέντρο του εστιασμένου παραθύρου"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Εμφάνιση/Απόκρυψη του αναδυόμενου παραθύρου προχείρου"

#: prefs.js:306
msgid "Search in popup"
msgstr "Αναζήτηση στο αναδυόμενο παράθυρο"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Διαγραφή επιλεγμένης καταχώρησης"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Εναλλαγή ιδιωτικής λειτουργίας"

#: prefs.js:309
msgid "Next page"
msgstr "Επόμενη σελίδα"

#: prefs.js:310
msgid "Previous page"
msgstr "Προηγούμενη σελίδα"

#: prefs.js:311
msgid "Move selection up"
msgstr "Μετακίνηση επιλογής προς τα πάνω"

#: prefs.js:312
msgid "Move selection down"
msgstr "Μετακίνηση επιλογής προς τα κάτω"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Επιβεβαίωση επιλογής"

#: prefs.js:314
msgid "Close popup"
msgstr "Κλείσιμο αναδυόμενου παραθύρου"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Διάκριση πεζών-κεφαλαίων (κατά την αναζήτηση)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Χρήση κανονικής έκφρασης (κατά την αναζήτηση)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Ενεργοποίηση συντομεύσεων"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Εμφάνιση εικονιδίων υπενθύμισης συντομεύσεων"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Εμφάνιση των εικονιδίων υπενθύμισης συντομεύσεων στο κάτω μέρος του "
"αναδυόμενου παραθύρου"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Επαναφορά συντομεύσεων στις προεπιλογές"

#: prefs.js:351
msgid "Reset"
msgstr "Επαναφορά"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Προσθήκη συντόμευσης"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Αφαίρεση συντόμευσης"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Απενεργοποιημένο"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Εισαγάγετε συντόμευση…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Επιλογή από εγκατεστημένες εφαρμογές"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Αναζήτηση εφαρμογών…"

