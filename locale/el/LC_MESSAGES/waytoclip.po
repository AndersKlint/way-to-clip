msgstr "Όρια"

#: prefs.js:216
msgid "Global shortcuts"
msgstr "Καθολικές συντομεύσεις πληκτρολογίου"

#: prefs.js:221
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""
"Απενεργοποιημένο από προεπιλογή· αντιστοιχίστε μια συντόμευση "
"παρακάτω για να ενεργοποιήσετε κάθε ενέργεια"

#: prefs.js:223
msgid "Popup shortcuts"
msgstr "Συντομεύσεις αναδυόμενου παραθύρου"

#: prefs.js:281
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Όνομα κλάσης παραθύρου, π.χ. «KeePassXC»"

#: prefs.js:290
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Κλάση παραθύρου ή id εφαρμογής, π.χ. «org.gnome.Ptyxis»"

