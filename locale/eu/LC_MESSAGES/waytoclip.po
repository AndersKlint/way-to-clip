#: extension.js:168
msgid "Show clipboard popup"
msgstr "Erakutsi arbelaren leiho emergentea"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Modu pribatua"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Garbitu historia"

#: extension.js:242
msgid "Settings"
msgstr "Ezarpenak"

#: extension.js:329
msgid "Clear all?"
msgstr "Guztia garbitu?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Ziur arbeleko elementu guztiak kendu nahi dituzula?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Ezin da eragiketa hau desegin."

#: extension.js:332
msgid "Clear"
msgstr "Garbitu"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Utzi"

#: prefs.js:46
msgid "History Size"
msgstr "Historiaren tamaina"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Cache fitxategiaren gehienezko tamaina (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Erakutsi berrespena historia garbitzean"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Eraman elementua goraino hautatu ostean"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Mantendu hautatutako sarrera historia garbitu ondoren"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Garbitu arbelaren historia sistema berrabiaraztean"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Itsatsi automatikoki hautatzean"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Itsatsi automatikoki leiho emergentetik elementu bat hautatu ondoren"

#: prefs.js:85
msgid "Popup position"
msgstr "Leiho emergentearen kokapena"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Non erakutsi arbelaren leiho emergentea"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Mugatu orri kopurua"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Desaktibatuta dagoenean, leiho emergenteak arbelaren historia osoa erakusten "
"du"

#: prefs.js:96
msgid "Number of pages"
msgstr "Orri kopurua"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Orri bakoitzak 10 elementu erakusten ditu (Tab orriz aldatzeko)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Irudien miniatura tamaina (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Irudien aurrebista tamaina leiho emergentean"

#: prefs.js:116
msgid "Cache images"
msgstr "Gorde irudiak cachean"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Baztertutako aplikazioak"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Kopiatutako edukia ez da gordeko aplikazio hauek fokatuta dauden bitartean"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminal aplikazioak"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "Itsatsi automatikoak Ctrl+Shift+V erabiltzen du terminaletan. Gehitu zure "
"terminala itsasteak testu okerra txertatzen badu"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Garbitu arbelaren historia tarteka"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Historia garbitzeko tartea (minututan)"

#: prefs.js:168
msgid "Language"
msgstr "Hizkuntza"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Ezarpenak berriro ireki eta hedadura berrabiarazi behar da"

#: prefs.js:173
msgid "General"
msgstr "Orokorra"

#: prefs.js:174
msgid "Popup"
msgstr "Leiho emergentea"

#: prefs.js:175
msgid "Behavior"
msgstr "Portaera"

#: prefs.js:176
msgid "Exclusion"
msgstr "Bazterketa"

#: prefs.js:177
msgid "Limits"
msgstr "Mugak"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Laster-tekla globalak"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Leiho emergentearen laster-teklak"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Leiho klase izena, adib. «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Leiho klasea edo aplikazio id-a, adib. «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Sistema"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "Saguaren kurtsorean"

#: prefs.js:291
msgid "Center of focused window"
msgstr "Fokatutako leihoaren erdian"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Erakutsi/ezkutatu arbelaren leiho emergentea"

#: prefs.js:306
msgid "Search in popup"
msgstr "Bilatu leiho emergentean"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Ezabatu hautatutako sarrera"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Aldatu modu pribatua"

#: prefs.js:309
msgid "Next page"
msgstr "Hurrengo orria"

#: prefs.js:310
msgid "Previous page"
msgstr "Aurreko orria"

#: prefs.js:311
msgid "Move selection up"
msgstr "Mugitu hautapena gora"

#: prefs.js:312
msgid "Move selection down"
msgstr "Mugitu hautapena behera"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Berretsi hautapena"

#: prefs.js:314
msgid "Close popup"
msgstr "Itxi leiho emergentea"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Bereizi maiuskulak (bilatzean)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Erabili adierazpen erregularra (bilatzean)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Gaitu laster-teklak"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Erakutsi laster-tekla oroigarrien ikonoak"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Erakutsi laster-tekla oroigarrien ikonoak leiho emergentearen behealdean"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Berrezarri laster-teklak lehenetsietara"

#: prefs.js:351
msgid "Reset"
msgstr "Berrezarri"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Gehitu laster-tekla"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Kendu laster-tekla"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Desgaituta"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Sartu laster-tekla…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Aukeratu instalatutako aplikazioetatik"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Bilatu aplikazioak…"

#: cursor-popup/cursorPopup.js:338
#, javascript-format
msgid "Match Case (%s)"
msgstr "Bereizi maiuskulak (%s)"

#: cursor-popup/cursorPopup.js:342
#, javascript-format
msgid "Use Regular Expression (%s)"
msgstr "Erabili adierazpen erregularra (%s)"

#: cursor-popup/cursorPopup.js:379
#, javascript-format
msgid "Toggle search (%s)"
msgstr "Erakutsi/ezkutatu bilaketa (%s)"

#: cursor-popup/cursorPopup.js:381
#, javascript-format
msgid "Toggle private mode (%s)"
msgstr "Aldatu modu pribatua (%s)"

#: cursor-popup/cursorPopup.js:383
#, javascript-format
msgid "Delete selected entry (%s)"
msgstr "Ezabatu hautatutako sarrera (%s)"

#: cursor-popup/cursorPopup.js:573
msgid "Clipboard history is empty"
msgstr "Arbelaren historia hutsik dago"

#: cursor-popup/cursorPopup.js:574
msgid "No matching clipboard items"
msgstr "Ez dago bat datorren arbel-elementurik"

#: cursor-popup/popupUI.js:101
msgid "Search..."
msgstr "Bilatu…"

#: cursor-popup/popupUI.js:341
msgid "Match Case (Alt+C)"
msgstr "Bereizi maiuskulak (Alt+C)"

#: cursor-popup/popupUI.js:343
msgid "Use Regular Expression (Alt+R)"
msgstr "Erabili adierazpen erregularra (Alt+R)"

#: cursor-popup/popupUI.js:418
msgid "Toggle search (s)"
msgstr "Erakutsi/ezkutatu bilaketa (s)"

#: cursor-popup/popupUI.js:420
msgid "Toggle private mode (p)"
msgstr "Aldatu modu pribatua (p)"

#: cursor-popup/popupUI.js:422
msgid "Delete selected entry (d)"
msgstr "Ezabatu hautatutako sarrera (d)"
