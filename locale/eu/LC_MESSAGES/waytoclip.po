#: prefs.js:80
msgid "History Size"
msgstr "Historiaren tamaina"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Cache fitxategiaren gehienezko tamaina (MB)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Erakutsi berrespena historia garbitzean"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Eraman elementua goraino hautatu ostean"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Mantendu hautatutako sarrera historia garbitu ondoren"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Garbitu arbelaren historia sistema berrabiaraztean"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Itsatsi automatikoki hautatzean"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "Itsatsi automatikoki leiho emergentetik elementu bat hautatu ondoren"

#: prefs.js:119
msgid "Popup position"
msgstr "Leiho emergentearen kokapena"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Non erakutsi arbelaren leiho emergentea"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Mugatu orri kopurua"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Desaktibatuta dagoenean, leiho emergenteak arbelaren historia osoa erakusten "
"du"

#: prefs.js:130
msgid "Number of pages"
msgstr "Orri kopurua"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Orri bakoitzak 10 elementu erakusten ditu (Tab orriz aldatzeko)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Irudien miniatura tamaina (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Irudien aurrebista tamaina leiho emergentean"

#: prefs.js:150
msgid "Cache images"
msgstr "Gorde irudiak cachean"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Gorde irudiak diskoan berrabiarazte bati eutsi diezaioten. Bestela memorian "
"bakarrik gordeko dira"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Baztertu arbelaren sekretuko motak"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Saltatu MIME mota sekretua duten edukiak (pasahitz-kudeatzaileak)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Gaitu gogokoak"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Markatu sarrerak gogoko gisa eta arakatu leiho emergentean"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Baztertutako aplikazioak"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Kopiatutako edukia ez da gordeko aplikazio hauek fokatuta dauden bitartean"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Terminal aplikazioak"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Itsatsi automatikoak Ctrl+Shift+V erabiltzen du terminaletan. Gehitu zure "
"terminala itsasteak testu okerra txertatzen badu"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Garbitu arbelaren historia tarteka"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Historia garbitzeko tartea (minututan)"

#: prefs.js:215
msgid "Language"
msgstr "Hizkuntza"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "Ezarpenak berriro ireki eta hedadura berrabiarazi behar da"

#: prefs.js:220
msgid "General"
msgstr "Orokorra"

#: prefs.js:221
msgid "Popup"
msgstr "Leiho emergentea"

#: prefs.js:222
msgid "Behavior"
msgstr "Portaera"

#: prefs.js:223
msgid "Exclusion"
msgstr "Bazterketa"

#: prefs.js:224
msgid "Limits"
msgstr "Mugak"

#: prefs.js:226
msgid "Global shortcuts"
msgstr "Laster-tekla globalak"

#: prefs.js:231
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""
"Lehenetsiz desgaituta; esleitu laster-tekla bat behean ekintza bakoitza "
"gaitzeko"

#: prefs.js:233
msgid "Popup shortcuts"
msgstr "Leiho emergentearen laster-teklak"

#: prefs.js:291
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Leiho klase izena, adib. «KeePassXC»"

#: prefs.js:300
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Leiho klasea edo aplikazio id-a, adib. «org.gnome.Ptyxis»"

#: prefs.js:310
msgid "System"
msgstr "Sistema"

#: prefs.js:346
msgid "At mouse cursor"
msgstr "Saguaren kurtsorean"

#: prefs.js:347
msgid "Center of focused window"
msgstr "Fokatutako leihoaren erdian"

#: prefs.js:352
msgid "Toggle the clipboard popup"
msgstr "Erakutsi/ezkutatu arbelaren leiho emergentea"

#: prefs.js:353 src/panel/panelButton.js:117
msgid "Private mode"
msgstr "Modu pribatua"

#: prefs.js:354 src/panel/panelButton.js:133
msgid "Clear history"
msgstr "Garbitu historia"

#: prefs.js:358
msgid "Search in popup"
msgstr "Bilatu leiho emergentean"

#: prefs.js:359
msgid "Delete selected entry"
msgstr "Ezabatu hautatutako sarrera"

#: prefs.js:360
msgid "Toggle private mode"
msgstr "Aldatu modu pribatua"

#: prefs.js:361
msgid "Next page"
msgstr "Hurrengo orria"

#: prefs.js:362
msgid "Previous page"
msgstr "Aurreko orria"

#: prefs.js:363
msgid "Move selection up"
msgstr "Mugitu hautapena gora"

#: prefs.js:364
msgid "Move selection down"
msgstr "Mugitu hautapena behera"

#: prefs.js:365
msgid "Confirm selection"
msgstr "Berretsi hautapena"

#: prefs.js:366
msgid "Close popup"
msgstr "Itxi leiho emergentea"

#: prefs.js:367
msgid "Match case (while searching)"
msgstr "Bereizi maiuskulak (bilatzean)"

#: prefs.js:368
msgid "Use regular expression (while searching)"
msgstr "Erabili adierazpen erregularra (bilatzean)"

#: prefs.js:369
msgid "Toggle favorite on selected entry"
msgstr "Aktibatu/desaktibatu hautatutako sarrera gogoko gisa"

#: prefs.js:370
msgid "Open favorites or go back"
msgstr "Ireki gogokoak edo itzuli"

#: prefs.js:371
msgid "Quick select item 1"
msgstr "1. sarreraren hautapen azkarra"

#: prefs.js:372
msgid "Quick select item 2"
msgstr "2. sarreraren hautapen azkarra"

#: prefs.js:373
msgid "Quick select item 3"
msgstr "3. sarreraren hautapen azkarra"

#: prefs.js:374
msgid "Quick select item 4"
msgstr "4. sarreraren hautapen azkarra"

#: prefs.js:375
msgid "Quick select item 5"
msgstr "5. sarreraren hautapen azkarra"

#: prefs.js:376
msgid "Quick select item 6"
msgstr "6. sarreraren hautapen azkarra"

#: prefs.js:377
msgid "Quick select item 7"
msgstr "7. sarreraren hautapen azkarra"

#: prefs.js:378
msgid "Quick select item 8"
msgstr "8. sarreraren hautapen azkarra"

#: prefs.js:379
msgid "Quick select item 9"
msgstr "9. sarreraren hautapen azkarra"

#: prefs.js:380
msgid "Quick select item 10"
msgstr "10. sarreraren hautapen azkarra"

#: prefs.js:401
msgid "Enable shortcuts"
msgstr "Gaitu laster-teklak"

#: prefs.js:410
msgid "Suggested shortcuts: Alt+X, Alt+C, or Alt+V"
msgstr "Iradokitako laster-teklak: Alt+X, Alt+C edo Alt+V"

#: prefs.js:456
msgid "Show shortcut reminder icons"
msgstr "Erakutsi laster-tekla oroigarrien ikonoak"

#: prefs.js:457
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr ""
"Erakutsi laster-tekla oroigarrien ikonoak leiho emergentearen behealdean"

#: prefs.js:466
msgid "Reset shortcuts to defaults"
msgstr "Berrezarri laster-teklak lehenetsietara"

#: prefs.js:468
msgid "Reset"
msgstr "Berrezarri"

#: src/wayToClipController.js:258
msgid "Clear all?"
msgstr "Guztia garbitu?"

#: src/wayToClipController.js:259
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Ziur arbeleko elementu guztiak kendu nahi dituzula?"

#: src/wayToClipController.js:260
msgid "This operation cannot be undone."
msgstr "Ezin da eragiketa hau desegin."

#: src/wayToClipController.js:261
msgid "Clear"
msgstr "Garbitu"

#: src/wayToClipController.js:262 prefs/shortcutEditor.js:50
