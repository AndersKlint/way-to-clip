#: prefs.js:70
msgid "History Size"
msgstr "Tamaño del historial"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Tamaño máximo de cache (MB)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Mostrar una confirmación al borrar el historial"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Mover el ítem hacia arriba después de seleccionarlo"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Mantener la entrada seleccionada después de vaciar el historial"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Vaciar el historial del portapapeles al reiniciar el sistema"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Pegado automático al seleccionar"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Pegar automáticamente tras seleccionar un elemento de la ventana emergente"

#: prefs.js:109
msgid "Popup position"
msgstr "Posición de la ventana emergente"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Dónde mostrar la ventana emergente del portapapeles"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Limitar el número de páginas"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Si está desactivado, la ventana emergente muestra todo el historial del "
"portapapeles"

#: prefs.js:120
msgid "Number of pages"
msgstr "Número de páginas"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada página muestra 10 elementos (Tab para cambiar de página)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Tamaño de miniaturas de imágenes (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Tamaño de vista previa de imágenes en la ventana emergente"

#: prefs.js:140
msgid "Cache images"
msgstr "Almacenar imágenes en caché"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Guarda las imágenes en el disco para que sobrevivan a un reinicio. "
"De lo contrario, solo se conservan en memoria"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Ignorar los tipos secretos del portapapeles"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Omitir el contenido marcado con un tipo MIME secreto (gestores de "
"contraseñas)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Habilitar favoritos"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr ""
"Marca las entradas como favoritas y explóralas en la ventana "
"emergente"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Aplicaciones excluidas"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"El contenido copiado no se guardará mientras estas aplicaciones estén "
"enfocadas"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Aplicaciones de terminal"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"El pegado automático usa Ctrl+Mayús+V en terminales. Añade tu terminal si al "
"pegar se inserta el texto incorrecto"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Vaciar el historial del portapapeles cada cierto tiempo"

#: prefs.js:186
msgid "History clear interval (in minutes)"
msgstr "Intervalo de vaciado del historial (en minutos)"

#: prefs.js:205
msgid "Language"
msgstr "Idioma"

#: prefs.js:206
msgid "Requires reopening Settings and restarting the extension"
msgstr "Requiere reabrir la Configuración y reiniciar la extensión"

#: prefs.js:210
msgid "General"
msgstr "General"

#: prefs.js:211
msgid "Popup"
msgstr "Ventana emergente"

#: prefs.js:212
msgid "Behavior"
