#: extension.js:168
msgid "Show clipboard popup"
msgstr "Mostrar ventana emergente del portapapeles"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Modo privado"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Vaciar historial"

#: extension.js:242
msgid "Settings"
msgstr "Configuración"

#: extension.js:329
msgid "Clear all?"
msgstr "¿Borrar todo?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "¿Está seguro de que quiere borrar todos los ítems del portapapeles?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Esta operación no puede ser deshecha."

#: extension.js:332
msgid "Clear"
msgstr "Borrar"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:46
msgid "History Size"
msgstr "Tamaño del historial"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Tamaño máximo de cache (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Mostrar una confirmación al borrar el historial"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Mover el ítem hacia arriba después de seleccionarlo"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Mantener la entrada seleccionada después de vaciar el historial"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Vaciar el historial del portapapeles al reiniciar el sistema"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Pegado automático al seleccionar"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Pegar automáticamente tras seleccionar un elemento de la ventana emergente"

#: prefs.js:85
msgid "Popup position"
msgstr "Posición de la ventana emergente"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Dónde mostrar la ventana emergente del portapapeles"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Limitar el número de páginas"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Si está desactivado, la ventana emergente muestra todo el historial del "
"portapapeles"

#: prefs.js:96
msgid "Number of pages"
msgstr "Número de páginas"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada página muestra 10 elementos (Tab para cambiar de página)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Tamaño de miniaturas de imágenes (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Tamaño de vista previa de imágenes en la ventana emergente"

#: prefs.js:116
msgid "Cache images"
msgstr "Almacenar imágenes en caché"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Aplicaciones excluidas"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "El contenido copiado no se guardará mientras estas aplicaciones estén "
"enfocadas"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Aplicaciones de terminal"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "El pegado automático usa Ctrl+Mayús+V en terminales. Añade tu terminal si al "
"pegar se inserta el texto incorrecto"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Vaciar el historial del portapapeles cada cierto tiempo"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Intervalo de vaciado del historial (en minutos)"

#: prefs.js:168
msgid "Language"
msgstr "Idioma"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Requiere reabrir la Configuración y reiniciar la extensión"

#: prefs.js:173
msgid "General"
msgstr "General"

#: prefs.js:174
msgid "Popup"
msgstr "Ventana emergente"

#: prefs.js:175
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:176
msgid "Exclusion"
msgstr "Exclusión"

#: prefs.js:177
msgid "Limits"
msgstr "Límites"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Atajos de teclado globales"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Atajos de teclado de la ventana emergente"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nombre de clase de ventana, p. ej. «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Clase de ventana o id de aplicación, p. ej. «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Sistema"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "En el cursor del ratón"

#: prefs.js:291
msgid "Center of focused window"
msgstr "En el centro de la ventana enfocada"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Mostrar/ocultar la ventana emergente del portapapeles"

#: prefs.js:306
msgid "Search in popup"
msgstr "Buscar en la ventana emergente"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Eliminar la entrada seleccionada"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Activar/desactivar el modo privado"

#: prefs.js:309
msgid "Next page"
msgstr "Página siguiente"

#: prefs.js:310
msgid "Previous page"
msgstr "Página anterior"

#: prefs.js:311
msgid "Move selection up"
msgstr "Mover la selección hacia arriba"

#: prefs.js:312
msgid "Move selection down"
msgstr "Mover la selección hacia abajo"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Confirmar la selección"

#: prefs.js:314
msgid "Close popup"
msgstr "Cerrar la ventana emergente"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Distinguir mayúsculas (al buscar)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Usar expresión regular (al buscar)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Habilitar atajos de teclado"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Mostrar iconos de recordatorio de atajos"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Mostrar los iconos de recordatorio de atajos en la parte inferior de la "
"ventana emergente"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Restablecer atajos a los valores predeterminados"

#: prefs.js:351
msgid "Reset"
msgstr "Restablecer"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Añadir atajo"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Eliminar atajo"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Deshabilitado"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Introduce atajo de teclado…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Elegir de las aplicaciones instaladas"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Buscar aplicaciones…"

