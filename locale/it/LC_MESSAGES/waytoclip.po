#: prefs.js:80
msgid "History Size"
msgstr "Dimensioni della cronologia"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Dimensione massima della cache (MB)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Mostra conferma per cancellare la cronologia"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Sposta l'elemento in cima dopo la selezione"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Mantieni l'elemento selezionato dopo aver cancellato la cronologia"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Cancella la cronologia al riavvio del sistema"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Incolla alla selezione"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Incolla automaticamente dopo aver selezionato un elemento dalla finestra"

#: prefs.js:119
msgid "Popup position"
msgstr "Posizione della finestra"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Dove mostrare la finestra degli appunti"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Limita il numero di pagine"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "Se disattivata, la finestra mostra l'intera cronologia degli appunti"

#: prefs.js:130
msgid "Number of pages"
msgstr "Numero di pagine"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Ogni pagina mostra 10 elementi (Tab per cambiare pagina)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Dimensione delle miniature delle immagini (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Dimensione dell'anteprima delle immagini nella finestra"

#: prefs.js:150
msgid "Cache images"
msgstr "Memorizza le immagini nella cache"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Salva le immagini su disco affinché sopravvivano a un riavvio. Altrimenti "
"vengono conservate solo in memoria"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Ignora i tipi segreti degli appunti"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Salta il contenuto contrassegnato con un tipo MIME segreto (gestori di "
"password)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Abilita preferiti"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Contrassegna gli elementi come preferiti e sfogliali nella finestra"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "App escluse"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Il contenuto copiato non verrà salvato mentre queste app sono in primo piano"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Terminali"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"L'incollamento automatico usa Ctrl+Maiusc+V nei terminali. Aggiungi il tuo "
"terminale se l'incollamento inserisce il testo sbagliato"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Cancella la cronologia degli appunti a intervalli regolari"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Intervallo di cancellazione della cronologia (in minuti)"

#: prefs.js:215
msgid "Language"
msgstr "Lingua"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "Richiede la riapertura delle Impostazioni e il riavvio dell'estensione"

#: prefs.js:220
msgid "General"
msgstr "Generale"

#: prefs.js:221
msgid "Popup"
msgstr "Finestra"

#: prefs.js:222
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:223
msgid "Exclusion"
msgstr "Esclusione"

#: prefs.js:224
msgid "Limits"
msgstr "Limiti"

#: prefs.js:226
msgid "Global shortcuts"
msgstr "Scorciatoie globali"

#: prefs.js:231
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""
"Disattivato per impostazione predefinita; assegna una scorciatoia qui sotto "
"per abilitare ciascuna azione"

#: prefs.js:233
msgid "Popup shortcuts"
msgstr "Scorciatoie della finestra"

#: prefs.js:291
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nome classe della finestra, ad esempio \"KeePassXC\""

#: prefs.js:300
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr ""
"Classe della finestra o ID applicazione, ad esempio \"org.gnome.Ptyxis\""

