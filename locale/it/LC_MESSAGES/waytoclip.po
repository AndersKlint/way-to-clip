#: extension.js:168
msgid "Show clipboard popup"
msgstr "Mostra la finestra degli appunti"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Modalità privata"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Cancella la cronologia"

#: extension.js:242
msgid "Settings"
msgstr "Impostazioni"

#: extension.js:329
msgid "Clear all?"
msgstr "Cancella tutto?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Sei sicuro di voler eliminare tutti gli elementi negli appunti?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Questa operazione non può essere annullata."

#: extension.js:332
msgid "Clear"
msgstr "Cancella"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Annulla"

#: prefs.js:46
msgid "History Size"
msgstr "Dimensioni della cronologia"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Dimensione massima della cache (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Mostra conferma per cancellare la cronologia"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Sposta l'elemento in cima dopo la selezione"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Mantieni l'elemento selezionato dopo aver cancellato la cronologia"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Cancella la cronologia al riavvio del sistema"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Incolla alla selezione"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Incolla automaticamente dopo aver selezionato un elemento dalla finestra"

#: prefs.js:85
msgid "Popup position"
msgstr "Posizione della finestra"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Dove mostrare la finestra degli appunti"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Limita il numero di pagine"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Se disattivata, la finestra mostra l'intera cronologia degli appunti"

#: prefs.js:96
msgid "Number of pages"
msgstr "Numero di pagine"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Ogni pagina mostra 10 elementi (Tab per cambiare pagina)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Dimensione delle miniature delle immagini (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Dimensione dell'anteprima delle immagini nella finestra"

#: prefs.js:116
msgid "Cache images"
msgstr "Memorizza le immagini nella cache"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "App escluse"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Il contenuto copiato non verrà salvato mentre queste app sono in primo piano"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminali"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"L'incollamento automatico usa Ctrl+Maiusc+V nei terminali. Aggiungi il tuo "
"terminale se l'incollamento inserisce il testo sbagliato"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Cancella la cronologia degli appunti a intervalli regolari"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Intervallo di cancellazione della cronologia (in minuti)"

#: prefs.js:168
msgid "Language"
msgstr "Lingua"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Richiede la riapertura delle Impostazioni e il riavvio dell'estensione"

#: prefs.js:173
msgid "General"
msgstr "Generale"

#: prefs.js:174
msgid "Popup"
msgstr "Finestra"

#: prefs.js:175
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:176
msgid "Exclusion"
msgstr "Esclusione"

#: prefs.js:177
msgid "Limits"
msgstr "Limiti"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Scorciatoie globali"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Scorciatoie della finestra"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nome classe della finestra, ad esempio \"KeePassXC\""

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Classe della finestra o ID applicazione, ad esempio \"org.gnome.Ptyxis\""

#: prefs.js:254
msgid "System"
msgstr "Sistema"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "Sul cursore del mouse"

#: prefs.js:291
msgid "Center of focused window"
msgstr "Al centro della finestra attiva"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Mostra/nascondi la finestra degli appunti"

#: prefs.js:306
msgid "Search in popup"
msgstr "Cerca nella finestra"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Elimina l'elemento selezionato"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Attiva/disattiva la modalità privata"

#: prefs.js:309
msgid "Next page"
msgstr "Pagina successiva"

#: prefs.js:310
msgid "Previous page"
msgstr "Pagina precedente"

#: prefs.js:311
msgid "Move selection up"
msgstr "Sposta la selezione verso l'alto"

#: prefs.js:312
msgid "Move selection down"
msgstr "Sposta la selezione verso il basso"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Conferma la selezione"

#: prefs.js:314
msgid "Close popup"
msgstr "Chiudi la finestra"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Distingui maiuscole/minuscole (durante la ricerca)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Usa espressioni regolari (durante la ricerca)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Abilita scorciatoie"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Mostra le icone di promemoria delle scorciatoie"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Mostra le icone di promemoria delle scorciatoie in fondo alla finestra"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Ripristina le scorciatoie predefinite"

#: prefs.js:351
msgid "Reset"
msgstr "Ripristina"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Aggiungi scorciatoia"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Rimuovi scorciatoia"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
