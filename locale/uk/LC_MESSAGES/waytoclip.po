msgstr "Наступна сторінка"

#: prefs.js:310
msgid "Previous page"
msgstr "Попередня сторінка"

#: prefs.js:311
msgid "Move selection up"
msgstr "Перемістити виділення вгору"

#: prefs.js:312
msgid "Move selection down"
msgstr "Перемістити виділення вниз"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Підтвердити вибір"

#: prefs.js:314
msgid "Close popup"
msgstr "Закрити спливне вікно"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Враховувати регістр (під час пошуку)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Використовувати регулярний вираз (під час пошуку)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Увімкнути клавіатурні скорочення"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Показувати значки-нагадування скорочень"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Показувати значки-нагадування скорочень унизу спливного вікна"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Скинути скорочення до стандартних"

#: prefs.js:351
msgid "Reset"
msgstr "Скинути"

