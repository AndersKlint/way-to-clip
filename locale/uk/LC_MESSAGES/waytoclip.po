#: extension.js:168
msgid "Show clipboard popup"
msgstr "Показати спливне вікно буфера обміну"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Приватний режим"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Очистити історію"

#: extension.js:242
msgid "Settings"
msgstr "Параметри"

#: extension.js:329
msgid "Clear all?"
msgstr "Очистити все?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Точно видалити всі записи з буфера обміну?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Цю операцію неможливо скасувати."

#: extension.js:332
msgid "Clear"
msgstr "Очистити"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Скасувати"

#: prefs.js:46
msgid "History Size"
msgstr "Розмір історії"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Максимальний розмір кешу (МБ)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Підтверджувати очищення історії"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Переміщувати вибраний елемент вгору"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Зберігати вибраний запис після очищення історії"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Очищати історію буфера обміну під час перезапуску"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Автовставлення під час вибору"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Автоматично вставляти після вибору елемента зі спливного вікна"

#: prefs.js:85
msgid "Popup position"
msgstr "Положення спливного вікна"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Місце показу спливного вікна буфера обміну"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Обмежити кількість сторінок"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "Якщо вимкнено, спливне вікно показує всю історію буфера обміну"

#: prefs.js:96
msgid "Number of pages"
msgstr "Кількість сторінок"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Кожна сторінка показує 10 елементів (Tab для переходу між сторінками)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Розмір мініатюр зображень (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Розмір попереднього перегляду зображень у спливному вікні"

#: prefs.js:116
msgid "Cache images"
msgstr "Кешувати зображення"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Виключені програми"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Скопійований вміст не зберігатиметься, поки ці програми у фокусі"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Термінали"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "Автовставлення використовує Ctrl+Shift+V у терміналах. Додайте свій "
"термінал, якщо вставлення підставляє неправильний текст"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Очищати історію буфера обміну через проміжки часу"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Інтервал очищення історії (у хвилинах)"

#: prefs.js:168
msgid "Language"
msgstr "Мова"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Потребує повторного відкриття Налаштувань і перезапуску розширення"

