msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Назва класу вікна, напр. «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Клас вікна або ID програми, напр. «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Система"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "Біля курсора миші"

#: prefs.js:291
msgid "Center of focused window"
msgstr "У центрі активного вікна"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Показати/приховати спливне вікно буфера обміну"

