#: extension.js:171
msgid "Show clipboard popup"
msgstr "Vágólap felugró ablak megjelenítése"

#: extension.js:188 prefs.js:303
msgid "Private mode"
msgstr "Privát mód"

#: extension.js:201 prefs.js:304
msgid "Clear history"
msgstr "Előzmények törlése"

#: extension.js:242
msgid "Settings"
msgstr "Beállítások"

#: extension.js:329
msgid "Clear all?"
msgstr "Összes törlése?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Biztos, hogy törli az összes vágólapelemet?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Ez a művelet nem vonható vissza."

#: extension.js:332
msgid "Clear"
msgstr "Törlés"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Mégse"

#: prefs.js:46
msgid "History Size"
msgstr "Előzmények száma"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Gyorsítótárfájl maximális mérete (MB)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Megerősítés megjelenítése az előzmények törlésekor"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Első helyre mozgatás kiválasztás után"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Kijelölt bejegyzés megtartása az előzmények törlése után"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Vágólapelőzmények törlése rendszerújraindításkor"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Automatikus beillesztés kijelöléskor"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "Automatikus beillesztés a felugró ablakból való választás után"

#: prefs.js:85
msgid "Popup position"
msgstr "Felugró ablak helyzete"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Hol jelenjen meg a vágólap felugró ablaka"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Oldalak számának korlátozása"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Kikapcsolt állapotban a felugró ablak a teljes vágólapelőzményt mutatja"

#: prefs.js:96
msgid "Number of pages"
msgstr "Oldalak száma"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Minden oldal 10 elemet mutat (Tab az oldalak közötti navigáláshoz)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Képbélyegképek mérete (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Képek előnézeti mérete a felugró ablakban"

#: prefs.js:116
msgid "Cache images"
msgstr "Képek gyorsítótárazása"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Kizárt alkalmazások"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"A másolt tartalom nem kerül mentésre, amíg ezek az alkalmazások vannak "
"fókuszban"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Terminálalkalmazások"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Az automatikus beillesztés Ctrl+Shift+V-t használ a terminálokban. Adja "
"hozzá a terminálját, ha a beillesztés hibás szöveget szúr be"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Vágólapelőzmények törlése időközönként"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Előzménytörlési időköz (percben)"

#: prefs.js:168
msgid "Language"
msgstr "Nyelv"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "A Beállítások újbóli megnyitását és a kiegészítő újraindítását igényli"

#: prefs.js:173
msgid "General"
msgstr "Általános"

#: prefs.js:174
msgid "Popup"
msgstr "Felugró ablak"

#: prefs.js:175
msgid "Behavior"
msgstr "Viselkedés"

#: prefs.js:176
msgid "Exclusion"
msgstr "Kizárás"

#: prefs.js:177
msgid "Limits"
msgstr "Korlátok"

#: prefs.js:179
msgid "Global shortcuts"
msgstr "Globális gyorsbillentyűk"

#: prefs.js:182
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr ""

#: prefs.js:184
msgid "Popup shortcuts"
msgstr "Felugró ablak gyorsbillentyűi"

#: prefs.js:240
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Ablákosztály neve, pl. «KeePassXC»"

#: prefs.js:249
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Ablákosztály vagy alkalmazásazonosító, pl. «org.gnome.Ptyxis»"

#: prefs.js:259
msgid "System"
msgstr "Rendszer"

#: prefs.js:295
msgid "At mouse cursor"
msgstr "Az egérkurzornál"

#: prefs.js:296
msgid "Center of focused window"
msgstr "A fókuszált ablak közepén"

#: prefs.js:302
msgid "Toggle the clipboard popup"
msgstr "Vágólap felugró ablak megjelenítése/elrejtése"

#: prefs.js:311
msgid "Search in popup"
msgstr "Keresés a felugró ablakban"

#: prefs.js:312
msgid "Delete selected entry"
msgstr "Kijelölt bejegyzés törlése"

#: prefs.js:313
msgid "Toggle private mode"
msgstr "Privát mód be-/kikapcsolása"

#: prefs.js:314
msgid "Next page"
msgstr "Következő oldal"

#: prefs.js:315
msgid "Previous page"
msgstr "Előző oldal"

#: prefs.js:316
msgid "Move selection up"
msgstr "Kijelölés mozgatása felfelé"

#: prefs.js:317
msgid "Move selection down"
msgstr "Kijelölés mozgatása lefelé"

#: prefs.js:318
msgid "Confirm selection"
msgstr "Kijelölés megerősítése"

#: prefs.js:319
msgid "Close popup"
msgstr "Felugró ablak bezárása"

#: prefs.js:320
msgid "Match case (while searching)"
msgstr "Kis- és nagybetűk megkülönböztetése (kereséskor)"

#: prefs.js:321
msgid "Use regular expression (while searching)"
msgstr "Reguláris kifejezés használata (kereséskor)"

#: prefs.js:334
msgid "Enable shortcuts"
msgstr "Gyorsbillentyűk engedélyezése"

#: prefs.js:344
msgid "Show shortcut reminder icons"
msgstr "Gyorsbillentyű-emlékeztető ikonok megjelenítése"

#: prefs.js:345
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Gyorsbillentyű-emlékeztető ikonok megjelenítése a felugró ablak alján"

#: prefs.js:354
msgid "Reset shortcuts to defaults"
msgstr "Gyorsbillentyűk visszaállítása alapértelmezettre"

#: prefs.js:356
msgid "Reset"
msgstr "Visszaállítás"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Gyorsbillentyű hozzáadása"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Gyorsbillentyű eltávolítása"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:364
msgid "Disabled"
msgstr "Letiltva"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Gyorsbillentyű megadása…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "Választás a telepített alkalmazások közül"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "Alkalmazások keresése…"

