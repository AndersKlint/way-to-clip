#: prefs.js:401
msgid "Enable shortcuts"
msgstr "تفعيل إختصارات لوحة المفاتيح"

#: prefs.js:410
msgid "Suggested shortcuts: Alt+X, Alt+C, or Alt+V"
msgstr "اختصارات مقترحة: Alt+X، Alt+C أو Alt+V"

#: prefs.js:456
msgid "Show shortcut reminder icons"
msgstr "إظهار أيقونات تذكير الاختصارات"

#: prefs.js:457
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "إظهار أيقونات تذكير الاختصارات في أسفل النافذة المنبثقة"

#: prefs.js:466
msgid "Reset shortcuts to defaults"
msgstr "إعادة تعيين الاختصارات إلى الافتراضية"

#: prefs.js:468
msgid "Reset"
msgstr "إعادة تعيين"

#: src/wayToClipController.js:258
msgid "Clear all?"
msgstr "حذف الكل؟"

#: src/wayToClipController.js:259
msgid "Are you sure you want to delete all clipboard items?"
msgstr "هل أنت متأكد أنك تريد حذف جميع عناصر الحافظة؟"

#: src/wayToClipController.js:260
msgid "This operation cannot be undone."
msgstr "هذه العملية لا يمكن التراجع عنها."

#: src/wayToClipController.js:261
