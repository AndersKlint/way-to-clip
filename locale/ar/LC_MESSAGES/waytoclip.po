#: prefs.js:80
msgid "History Size"
msgstr "عدد العناصر في السجل"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "أقصى حجم لملف ذاكرة التخزين المؤقت بالميجابايت"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "إظهار تأكيد عند مسح السجل"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "انقل العنصر إلى الأعلى بعد إختياره"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "الاحتفاظ بالإدخال المحدد بعد مسح السجل"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "مسح سجل الحافظة عند إعادة تشغيل النظام"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "اللصق التلقائي عند التحديد"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "اللصق تلقائيًا بعد تحديد عنصر من النافذة المنبثقة"

#: prefs.js:119
msgid "Popup position"
msgstr "موضع النافذة المنبثقة"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "مكان إظهار نافذة الحافظة المنبثقة"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "تحديد عدد الصفحات"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "عند التعطيل، تعرض النافذة المنبثقة سجل الحافظة الكامل"

#: prefs.js:130
msgid "Number of pages"
msgstr "عدد الصفحات"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "تعرض كل صفحة 10 عناصر (Tab للتنقل بين الصفحات)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "حجم مصغرات الصور (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "حجم معاينة الصور في النافذة المنبثقة"

#: prefs.js:150
msgid "Cache images"
msgstr "تخزين الصور مؤقتًا"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr "احفظ الصور على القرص لتبقى بعد إعادة التشغيل، وإلا تُحفظ في الذاكرة فقط"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "تجاهل أنواع الحافظة السرية"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "تخطي المحتوى المعلَّم بنوع MIME سري (مديرو كلمات المرور)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "تفعيل المفضلة"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "ضع علامة على الإدخالات كمفضلة وتصفحها في النافذة المنبثقة"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "التطبيقات المستبعدة"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr "لن يتم حفظ المحتوى المنسوخ أثناء تركيز هذه التطبيقات"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "تطبيقات الطرفية"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"يستخدم اللصق التلقائي Ctrl+Shift+V في الطرفيات. أضف طرفيتك إذا كان اللصق "
"يُدخل نصًا خاطئًا"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "مسح سجل الحافظة على فترات"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "الفاصل الزمني لمسح السجل (بالدقائق)"

#: prefs.js:215
msgid "Language"
msgstr "اللغة"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "يتطلب إعادة فتح الإعدادات وإعادة تشغيل الامتداد"

#: prefs.js:220
msgid "General"
msgstr "عام"

#: prefs.js:221
msgid "Popup"
msgstr "النافذة المنبثقة"

#: prefs.js:222
msgid "Behavior"
msgstr "السلوك"

#: prefs.js:223
msgid "Exclusion"
msgstr "الاستبعاد"

#: prefs.js:224
msgid "Limits"
msgstr "الحدود"

#: prefs.js:226
msgid "Global shortcuts"
msgstr "إختصارات لوحة المفاتيح العامة"

#: prefs.js:231
msgid "Disabled by default; assign a shortcut below to enable each action"
msgstr "معطل افتراضيًا؛ عيّن اختصارًا أدناه لتفعيل كل إجراء"

#: prefs.js:233
msgid "Popup shortcuts"
msgstr "إختصارات النافذة المنبثقة"

#: prefs.js:291
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "اسم فئة النافذة، مثل «KeePassXC»"

#: prefs.js:300
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "فئة النافذة أو معرّف التطبيق، مثل «org.gnome.Ptyxis»"

#: prefs.js:310
msgid "System"
msgstr "النظام"

#: prefs.js:346
msgid "At mouse cursor"
msgstr "عند مؤشر الفأرة"

#: prefs.js:347
msgid "Center of focused window"
msgstr "في وسط النافذة المُركّز عليها"

#: prefs.js:352
msgid "Toggle the clipboard popup"
msgstr "إظهار/إخفاء نافذة الحافظة المنبثقة"

#: prefs.js:353 src/panel/panelButton.js:117
msgid "Private mode"
msgstr "الوضع السري"

#: prefs.js:354 src/panel/panelButton.js:133
msgid "Clear history"
msgstr "محو السجل"

#: prefs.js:358
msgid "Search in popup"
msgstr "البحث في النافذة المنبثقة"

#: prefs.js:359
msgid "Delete selected entry"
msgstr "حذف الإدخال المحدد"

#: prefs.js:360
msgid "Toggle private mode"
msgstr "تبديل الوضع السري"

#: prefs.js:361
msgid "Next page"
msgstr "الصفحة التالية"

#: prefs.js:362
msgid "Previous page"
msgstr "الصفحة السابقة"

#: prefs.js:363
msgid "Move selection up"
msgstr "نقل التحديد لأعلى"

#: prefs.js:364
msgid "Move selection down"
msgstr "نقل التحديد لأسفل"

#: prefs.js:365
msgid "Confirm selection"
msgstr "تأكيد التحديد"

#: prefs.js:366
msgid "Close popup"
msgstr "إغلاق النافذة المنبثقة"

#: prefs.js:367
msgid "Match case (while searching)"
msgstr "مطابقة الحالة (أثناء البحث)"

#: prefs.js:368
msgid "Use regular expression (while searching)"
msgstr "استخدام تعبير نمطي (أثناء البحث)"

#: prefs.js:369
msgid "Toggle favorite on selected entry"
msgstr "تبديل حالة المفضلة للإدخال المحدد"

#: prefs.js:370
msgid "Open favorites or go back"
msgstr "فتح المفضلة أو الرجوع"

#: prefs.js:371
msgid "Quick select item 1"
msgstr "التحديد السريع للإدخال 1"

#: prefs.js:372
msgid "Quick select item 2"
