#: extension.js:168
msgid "Show clipboard popup"
msgstr "إظهار نافذة الحافظة المنبثقة"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "الوضع السري"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "محو السجل"

#: extension.js:242
msgid "Settings"
msgstr "الإعدادات"

#: extension.js:329
msgid "Clear all?"
msgstr "حذف الكل؟"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "هل أنت متأكد أنك تريد حذف جميع عناصر الحافظة؟"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "هذه العملية لا يمكن التراجع عنها."

#: extension.js:332
msgid "Clear"
msgstr "مسح"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "إلغاء"

#: prefs.js:46
msgid "History Size"
msgstr "عدد العناصر في السجل"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "أقصى حجم لملف ذاكرة التخزين المؤقت بالميجابايت"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "إظهار تأكيد عند مسح السجل"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "انقل العنصر إلى الأعلى بعد إختياره"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "الاحتفاظ بالإدخال المحدد بعد مسح السجل"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "مسح سجل الحافظة عند إعادة تشغيل النظام"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "اللصق التلقائي عند التحديد"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr "اللصق تلقائيًا بعد تحديد عنصر من النافذة المنبثقة"

#: prefs.js:85
msgid "Popup position"
msgstr "موضع النافذة المنبثقة"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "مكان إظهار نافذة الحافظة المنبثقة"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "تحديد عدد الصفحات"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr "عند التعطيل، تعرض النافذة المنبثقة سجل الحافظة الكامل"

#: prefs.js:96
msgid "Number of pages"
msgstr "عدد الصفحات"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "تعرض كل صفحة 10 عناصر (Tab للتنقل بين الصفحات)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "حجم مصغرات الصور (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "حجم معاينة الصور في النافذة المنبثقة"

#: prefs.js:116
msgid "Cache images"
msgstr "تخزين الصور مؤقتًا"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "التطبيقات المستبعدة"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr "لن يتم حفظ المحتوى المنسوخ أثناء تركيز هذه التطبيقات"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "تطبيقات الطرفية"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr "يستخدم اللصق التلقائي Ctrl+Shift+V في الطرفيات. أضف طرفيتك إذا كان اللصق "
"يُدخل نصًا خاطئًا"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "مسح سجل الحافظة على فترات"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "الفاصل الزمني لمسح السجل (بالدقائق)"

#: prefs.js:168
msgid "Language"
msgstr "اللغة"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "يتطلب إعادة فتح الإعدادات وإعادة تشغيل الامتداد"

#: prefs.js:173
msgid "General"
msgstr "عام"

#: prefs.js:174
msgid "Popup"
msgstr "النافذة المنبثقة"

#: prefs.js:175
msgid "Behavior"
msgstr "السلوك"

#: prefs.js:176
msgid "Exclusion"
msgstr "الاستبعاد"

#: prefs.js:177
msgid "Limits"
msgstr "الحدود"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "إختصارات لوحة المفاتيح العامة"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "إختصارات النافذة المنبثقة"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "اسم فئة النافذة، مثل «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "فئة النافذة أو معرّف التطبيق، مثل «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "النظام"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "عند مؤشر الفأرة"

#: prefs.js:291
msgid "Center of focused window"
msgstr "في وسط النافذة المُركّز عليها"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "إظهار/إخفاء نافذة الحافظة المنبثقة"

#: prefs.js:306
msgid "Search in popup"
msgstr "البحث في النافذة المنبثقة"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "حذف الإدخال المحدد"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "تبديل الوضع السري"

#: prefs.js:309
msgid "Next page"
msgstr "الصفحة التالية"

#: prefs.js:310
msgid "Previous page"
msgstr "الصفحة السابقة"

#: prefs.js:311
msgid "Move selection up"
msgstr "نقل التحديد لأعلى"

#: prefs.js:312
msgid "Move selection down"
msgstr "نقل التحديد لأسفل"

#: prefs.js:313
msgid "Confirm selection"
msgstr "تأكيد التحديد"

#: prefs.js:314
msgid "Close popup"
msgstr "إغلاق النافذة المنبثقة"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "مطابقة الحالة (أثناء البحث)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "استخدام تعبير نمطي (أثناء البحث)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "تفعيل إختصارات لوحة المفاتيح"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "إظهار أيقونات تذكير الاختصارات"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "إظهار أيقونات تذكير الاختصارات في أسفل النافذة المنبثقة"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "إعادة تعيين الاختصارات إلى الافتراضية"

#: prefs.js:351
msgid "Reset"
msgstr "إعادة تعيين"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "إضافة اختصار"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "إزالة اختصار"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "معطّل"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "أدخل الاختصار…"

#: prefs/stringListManager.js:101
msgid "Choose from installed applications"
msgstr "الاختيار من التطبيقات المثبتة"

#: prefs/stringListManager.js:113
msgid "Search applications..."
msgstr "البحث في التطبيقات…"

#: cursor-popup/cursorPopup.js:338
#, javascript-format
msgid "Match Case (%s)"
msgstr "مطابقة الحالة (%s)"

#: cursor-popup/cursorPopup.js:342
#, javascript-format
msgid "Use Regular Expression (%s)"
msgstr "استخدام تعبير نمطي (%s)"

#: cursor-popup/cursorPopup.js:379
#, javascript-format
msgid "Toggle search (%s)"
msgstr "إظهار/إخفاء البحث (%s)"

#: cursor-popup/cursorPopup.js:381
#, javascript-format
msgid "Toggle private mode (%s)"
msgstr "تبديل الوضع السري (%s)"

#: cursor-popup/cursorPopup.js:383
#, javascript-format
msgid "Delete selected entry (%s)"
msgstr "حذف الإدخال المحدد (%s)"

#: cursor-popup/cursorPopup.js:573
msgid "Clipboard history is empty"
msgstr "سجل الحافظة فارغ"

#: cursor-popup/cursorPopup.js:574
msgid "No matching clipboard items"
msgstr "لا توجد عناصر مطابقة في الحافظة"

#: cursor-popup/popupUI.js:101
msgid "Search..."
msgstr "بحث…"

#: cursor-popup/popupUI.js:341
msgid "Match Case (Alt+C)"
msgstr "مطابقة الحالة (Alt+C)"

#: cursor-popup/popupUI.js:343
msgid "Use Regular Expression (Alt+R)"
msgstr "استخدام تعبير نمطي (Alt+R)"

#: cursor-popup/popupUI.js:418
msgid "Toggle search (s)"
msgstr "إظهار/إخفاء البحث (s)"

#: cursor-popup/popupUI.js:420
msgid "Toggle private mode (p)"
msgstr "تبديل الوضع السري (p)"

#: cursor-popup/popupUI.js:422
msgid "Delete selected entry (d)"
msgstr "حذف الإدخال المحدد (d)"
