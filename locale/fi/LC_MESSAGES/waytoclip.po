#: prefs.js:70
msgid "History Size"
msgstr "Historian koko"

#: prefs.js:79
msgid "Max cache file size (MB)"
msgstr "Välimuistitiedoston enimmäiskoko (Mt)"

#: prefs.js:88
msgid "Show confirmation on Clear History"
msgstr "Näytä vahvistus historiaa tyhjennettäessä"

#: prefs.js:92
msgid "Move item to the top after selection"
msgstr "Siirrä kohde alkuun valinnan jälkeen"

#: prefs.js:96
msgid "Keep selected entry after Clear History"
msgstr "Säilytä valittu tietue historian tyhjentämisen jälkeen"

#: prefs.js:100
msgid "Clear clipboard history on system reboot"
msgstr "Tyhjennä leikepöydän historia järjestelmän uudelleenkäynnistyksessä"

#: prefs.js:104
msgid "Auto-paste on selection"
msgstr "Liitä automaattisesti valittaessa"

#: prefs.js:105
msgid "Automatically paste after selecting an item from the popup"
msgstr "Liitä automaattisesti ponnahdusikkunasta valitun kohteen jälkeen"

#: prefs.js:109
msgid "Popup position"
msgstr "Ponnahdusikkunan sijainti"

#: prefs.js:110
msgid "Where to show the clipboard popup"
msgstr "Missä leikepöydän ponnahdusikkuna näytetään"

#: prefs.js:115
msgid "Limit number of pages"
msgstr "Rajoita sivujen määrää"

#: prefs.js:116
msgid "When off, the popup shows the full clipboard history"
msgstr "Kun pois käytöstä, ponnahdusikkuna näyttää koko leikepöydän historian"

#: prefs.js:120
msgid "Number of pages"
msgstr "Sivujen määrä"

#: prefs.js:121
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Jokainen sivu näyttää 10 kohdetta (Tab sivujen vaihtamiseen)"

#: prefs.js:130
msgid "Image thumbnail size (px)"
msgstr "Kuvien pienoiskuvien koko (px)"

#: prefs.js:131
msgid "Preview size for images in the popup"
msgstr "Kuvien esikatselukoko ponnahdusikkunassa"

#: prefs.js:140
msgid "Cache images"
msgstr "Tallenna kuvat välimuistiin"

#: prefs.js:141
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Tallenna kuvat levylle, jotta ne säilyvät uudelleenkäynnistyksen "
"yli. Muuten ne säilytetään vain muistissa"

#: prefs.js:146
msgid "Ignore secret clipboard types"
msgstr "Jätä salaiset leikepöytätyypit huomiotta"

#: prefs.js:147
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Ohita salaisella MIME-tyypillä merkitty sisältö "
"(salasananhallintaohjelmat)"

#: prefs.js:151
msgid "Enable favorites"
msgstr "Ota suosikit käyttöön"

#: prefs.js:152
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Merkitse kohteet suosikeiksi ja selaa niitä ponnahdusikkunassa"

#: prefs.js:156
msgid "Excluded Apps"
msgstr "Poissuljetut sovellukset"

#: prefs.js:157
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Kopioitua sisältöä ei tallenneta, kun nämä sovellukset ovat aktiivisina"

#: prefs.js:169
msgid "Terminal Apps"
msgstr "Päätesovellukset"

#: prefs.js:170
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Automaattiliittäminen käyttää Ctrl+Shift+V päätteissä. Lisää päätteesi, jos "
"liittäminen lisää väärää tekstiä"

#: prefs.js:182
msgid "Clear clipboard history on interval"
msgstr "Tyhjennä leikepöydän historia säännöllisin väliajoin"

