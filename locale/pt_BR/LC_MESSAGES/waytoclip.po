#: prefs.js:80
msgid "History Size"
msgstr "Tamanho do histórico"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Tamanho máximo do arquivo de cache (MB)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Mostrar confirmação ao limpar histórico"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Mover o item para o topo após a seleção"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Manter entrada selecionada após limpar histórico"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Limpar histórico da área de transferência ao reiniciar o sistema"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Colar automaticamente ao selecionar"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "Colar automaticamente após selecionar um item da janela"

#: prefs.js:119
msgid "Popup position"
msgstr "Posição da janela"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Onde mostrar a janela da área de transferência"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Limitar número de páginas"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Quando desativado, a janela mostra todo o histórico da área de transferência"

#: prefs.js:130
msgid "Number of pages"
msgstr "Número de páginas"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Cada página mostra 10 itens (Tab para navegar entre páginas)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Tamanho das miniaturas de imagens (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Tamanho da pré-visualização de imagens na janela"

#: prefs.js:150
msgid "Cache images"
msgstr "Armazenar imagens em cache"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Salve imagens no disco para que sobrevivam a uma reinicialização. Caso "
"contrário, elas são mantidas apenas na memória"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Ignorar tipos secretos da área de transferência"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr ""
"Ignorar conteúdo marcado com tipo MIME secreto (gerenciadores de senhas)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Ativar favoritos"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Marque entradas como favoritas e navegue por elas na janela"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Aplicativos excluídos"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"O conteúdo copiado não será salvo enquanto estes aplicativos estiverem em "
"foco"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Aplicativos de terminal"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"A colagem automática usa Ctrl+Shift+V em terminais. Adicione seu terminal se "
"colar inserir o texto errado"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Limpar histórico da área de transferência em intervalos"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Intervalo de limpeza do histórico (em minutos)"

