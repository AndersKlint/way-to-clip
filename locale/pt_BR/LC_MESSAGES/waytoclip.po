msgid "Clear history"
msgstr "Apagar histórico"

#: extension.js:242
msgid "Settings"
msgstr "Configurações"

#: extension.js:329
msgid "Clear all?"
msgstr "Deseja limpar tudo?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr ""
"Tem certeza de que deseja excluir todos os itens da área de transferência?"

