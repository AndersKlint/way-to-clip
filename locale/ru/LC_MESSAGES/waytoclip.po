#: prefs.js:80
msgid "History Size"
msgstr "Размер истории"

#: prefs.js:89
msgid "Max cache file size (MB)"
msgstr "Максимальный размер кэша (МБ)"

#: prefs.js:98
msgid "Show confirmation on Clear History"
msgstr "Показывать подтверждение при очистке истории"

#: prefs.js:102
msgid "Move item to the top after selection"
msgstr "Переместить запись в начало после выделения"

#: prefs.js:106
msgid "Keep selected entry after Clear History"
msgstr "Не очищать выбранную запись после очистки истории"

#: prefs.js:110
msgid "Clear clipboard history on system reboot"
msgstr "Очищать историю буфера обмена при перезагрузке системы"

#: prefs.js:114
msgid "Auto-paste on selection"
msgstr "Автовставка при выборе"

#: prefs.js:115
msgid "Automatically paste after selecting an item from the popup"
msgstr "Автоматически вставлять после выбора элемента во всплывающем окне"

#: prefs.js:119
msgid "Popup position"
msgstr "Положение всплывающего окна"

#: prefs.js:120
msgid "Where to show the clipboard popup"
msgstr "Место отображения всплывающего окна буфера обмена"

#: prefs.js:125
msgid "Limit number of pages"
msgstr "Ограничить число страниц"

#: prefs.js:126
msgid "When off, the popup shows the full clipboard history"
msgstr "Если выключено, всплывающее окно показывает всю историю буфера обмена"

#: prefs.js:130
msgid "Number of pages"
msgstr "Число страниц"

#: prefs.js:131
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr ""
"Каждая страница показывает 10 элементов (Tab для перехода между страницами)"

#: prefs.js:140
msgid "Image thumbnail size (px)"
msgstr "Размер миниатюр изображений (px)"

#: prefs.js:141
msgid "Preview size for images in the popup"
msgstr "Размер предпросмотра изображений во всплывающем окне"

#: prefs.js:150
msgid "Cache images"
msgstr "Кеш изображений"

#: prefs.js:151
msgid ""
"Save images to disk so they survive a restart. Otherwise they are kept in "
"memory only"
msgstr ""
"Сохраняйте изображения на диск, чтобы они пережили перезапуск. Иначе они "
"хранятся только в памяти"

#: prefs.js:156
msgid "Ignore secret clipboard types"
msgstr "Игнорировать секретные типы буфера обмена"

#: prefs.js:157
msgid "Skip content marked with a secret mimetype (password managers)"
msgstr "Пропускать содержимое с секретным MIME-типом (менеджеры паролей)"

#: prefs.js:161
msgid "Enable favorites"
msgstr "Включить избранное"

#: prefs.js:162
msgid "Mark entries as favorites and browse them in the popup"
msgstr "Отмечайте записи как избранные и просматривайте их во всплывающем окне"

#: prefs.js:166
msgid "Excluded Apps"
msgstr "Исключённые приложения"

#: prefs.js:167
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Скопированное содержимое не будет сохранено, пока эти приложения находятся в "
"фокусе"

#: prefs.js:179
msgid "Terminal Apps"
msgstr "Терминалы"

#: prefs.js:180
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Автовставка использует Ctrl+Shift+V в терминалах. Добавьте свой терминал, "
"если вставка подставляет неверный текст"

#: prefs.js:192
msgid "Clear clipboard history on interval"
msgstr "Очищать историю буфера обмена через интервалы"

#: prefs.js:196
msgid "History clear interval (in minutes)"
msgstr "Интервал очистки истории (в минутах)"

#: prefs.js:215
msgid "Language"
msgstr "Язык"

#: prefs.js:216
msgid "Requires reopening Settings and restarting the extension"
msgstr "Требуется заново открыть Настройки и перезапустить расширение"

#: prefs.js:220
msgid "General"
msgstr "Общие"

#: prefs.js:221
msgid "Popup"
msgstr "Всплывающее окно"

#: prefs.js:222
msgid "Behavior"
