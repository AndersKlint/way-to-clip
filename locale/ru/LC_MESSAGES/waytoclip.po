#: extension.js:168
msgid "Show clipboard popup"
msgstr "Показать всплывающее окно буфера обмена"

#: extension.js:188 prefs.js:298
msgid "Private mode"
msgstr "Приватный режим"

#: extension.js:201 prefs.js:299
msgid "Clear history"
msgstr "Очистить историю"

#: extension.js:242
msgid "Settings"
msgstr "Настройки"

#: extension.js:329
msgid "Clear all?"
msgstr "Очистить всё?"

#: extension.js:330
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Вы уверены, что хотите удалить все элементы буфера обмена?"

#: extension.js:331
msgid "This operation cannot be undone."
msgstr "Эту операцию нельзя отменить."

#: extension.js:332
msgid "Clear"
msgstr "Очистить"

#: extension.js:333 prefs/shortcutRow.js:127
msgid "Cancel"
msgstr "Отменить"

#: prefs.js:46
msgid "History Size"
msgstr "Размер истории"

#: prefs.js:55
msgid "Max cache file size (MB)"
msgstr "Максимальный размер кэша (МБ)"

#: prefs.js:64
msgid "Show confirmation on Clear History"
msgstr "Показывать подтверждение при очистке истории"

#: prefs.js:68
msgid "Move item to the top after selection"
msgstr "Переместить запись в начало после выделения"

#: prefs.js:72
msgid "Keep selected entry after Clear History"
msgstr "Не очищать выбранную запись после очистки истории"

#: prefs.js:76
msgid "Clear clipboard history on system reboot"
msgstr "Очищать историю буфера обмена при перезагрузке системы"

#: prefs.js:80
msgid "Auto-paste on selection"
msgstr "Автовставка при выборе"

#: prefs.js:81
msgid "Automatically paste after selecting an item from the popup"
msgstr ""
"Автоматически вставлять после выбора элемента во всплывающем окне"

#: prefs.js:85
msgid "Popup position"
msgstr "Положение всплывающего окна"

#: prefs.js:86
msgid "Where to show the clipboard popup"
msgstr "Место отображения всплывающего окна буфера обмена"

#: prefs.js:91
msgid "Limit number of pages"
msgstr "Ограничить число страниц"

#: prefs.js:92
msgid "When off, the popup shows the full clipboard history"
msgstr ""
"Если выключено, всплывающее окно показывает всю историю буфера обмена"

#: prefs.js:96
msgid "Number of pages"
msgstr "Число страниц"

#: prefs.js:97
msgid "Each page shows 10 items (Tab to navigate pages)"
msgstr "Каждая страница показывает 10 элементов (Tab для перехода между страницами)"

#: prefs.js:106
msgid "Image thumbnail size (px)"
msgstr "Размер миниатюр изображений (px)"

#: prefs.js:107
msgid "Preview size for images in the popup"
msgstr "Размер предпросмотра изображений во всплывающем окне"

#: prefs.js:116
msgid "Cache images"
msgstr "Кеш изображений"

#: prefs.js:121
msgid "Excluded Apps"
msgstr "Исключённые приложения"

#: prefs.js:122
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Скопированное содержимое не будет сохранено, пока эти приложения находятся в "
"фокусе"

#: prefs.js:134
msgid "Terminal Apps"
msgstr "Терминалы"

#: prefs.js:135
msgid ""
"Auto-paste uses Ctrl+Shift+V in terminals. Add your terminal if pasting "
"inserts the wrong text"
msgstr ""
"Автовставка использует Ctrl+Shift+V в терминалах. Добавьте свой терминал, "
"если вставка подставляет неверный текст"

#: prefs.js:147
msgid "Clear clipboard history on interval"
msgstr "Очищать историю буфера обмена через интервалы"

#: prefs.js:151
msgid "History clear interval (in minutes)"
msgstr "Интервал очистки истории (в минутах)"

#: prefs.js:168
msgid "Language"
msgstr "Язык"

#: prefs.js:169
msgid "Requires reopening Settings and restarting the extension"
msgstr "Требуется заново открыть Настройки и перезапустить расширение"

#: prefs.js:173
msgid "General"
msgstr "Общие"

#: prefs.js:174
msgid "Popup"
msgstr "Всплывающее окно"

#: prefs.js:175
msgid "Behavior"
msgstr "Поведение"

#: prefs.js:176
msgid "Exclusion"
msgstr "Исключение"

#: prefs.js:177
msgid "Limits"
msgstr "Ограничения"

#: prefs.js:178
msgid "Global shortcuts"
msgstr "Глобальные горячие клавиши"

#: prefs.js:179
msgid "Popup shortcuts"
msgstr "Горячие клавиши всплывающего окна"

#: prefs.js:235
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Имя класса окна, например «KeePassXC»"

#: prefs.js:244
msgid "Window class or app id, e.g. \"org.gnome.Ptyxis\""
msgstr "Класс окна или ID приложения, например «org.gnome.Ptyxis»"

#: prefs.js:254
msgid "System"
msgstr "Система"

#: prefs.js:290
msgid "At mouse cursor"
msgstr "У курсора мыши"

#: prefs.js:291
msgid "Center of focused window"
msgstr "В центре активного окна"

#: prefs.js:297
msgid "Toggle the clipboard popup"
msgstr "Показать/скрыть всплывающее окно буфера обмена"

#: prefs.js:306
msgid "Search in popup"
msgstr "Поиск во всплывающем окне"

#: prefs.js:307
msgid "Delete selected entry"
msgstr "Удалить выбранную запись"

#: prefs.js:308
msgid "Toggle private mode"
msgstr "Включить/выключить приватный режим"

#: prefs.js:309
msgid "Next page"
msgstr "Следующая страница"

#: prefs.js:310
msgid "Previous page"
msgstr "Предыдущая страница"

#: prefs.js:311
msgid "Move selection up"
msgstr "Переместить выделение вверх"

#: prefs.js:312
msgid "Move selection down"
msgstr "Переместить выделение вниз"

#: prefs.js:313
msgid "Confirm selection"
msgstr "Подтвердить выбор"

#: prefs.js:314
msgid "Close popup"
msgstr "Закрыть всплывающее окно"

#: prefs.js:315
msgid "Match case (while searching)"
msgstr "Учитывать регистр (при поиске)"

#: prefs.js:316
msgid "Use regular expression (while searching)"
msgstr "Использовать регулярное выражение (при поиске)"

#: prefs.js:329
msgid "Enable shortcuts"
msgstr "Включить горячие клавиши"

#: prefs.js:339
msgid "Show shortcut reminder icons"
msgstr "Показывать значки-подсказки горячих клавиш"

#: prefs.js:340
msgid "Show the shortcut reminder icons at the bottom of the popup"
msgstr "Показывать значки-подсказки горячих клавиш внизу всплывающего окна"

#: prefs.js:349
msgid "Reset shortcuts to defaults"
msgstr "Сбросить горячие клавиши по умолчанию"

#: prefs.js:351
msgid "Reset"
msgstr "Сбросить"

#: prefs/shortcutRow.js:42 prefs/shortcutRow.js:115
msgid "Add shortcut"
msgstr "Добавить комбинацию клавиш"

#: prefs/shortcutRow.js:79
msgid "Remove shortcut"
msgstr "Удалить комбинацию клавиш"

#: prefs/shortcutRow.js:96 cursor-popup/cursorPopup.js:367
msgid "Disabled"
msgstr "Выключено"

#: prefs/shortcutRow.js:134
msgid "Enter shortcut…"
msgstr "Введите комбинацию клавиш…"

